@using SchoolLibrary.Services.Common
@using SchoolLibrary.Services.Quizzes
@model PagedResult<QuizListItem>

@{
    ViewData["Title"] = "Упражнения";
}

<partial name="_MessagePartial" />

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-card-checklist"></i> Упражнения <small class="fs-6 text-body-secondary">(@Model.TotalCount)</small></h1>
</div>

@if (Model.TotalCount == 0)
{
    <div class="alert alert-info text-center py-5">
        <p class="mb-0">Все още няма публикувани упражнения.</p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var item in Model.Items)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <h2 class="h5 card-title">@item.Quiz.Title</h2>
                        @if (!string.IsNullOrEmpty(item.Quiz.Description))
                        {
                            <p class="card-text text-body-secondary small">@item.Quiz.Description</p>
                        }
                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <span class="badge text-bg-light">@item.QuestionCount @(item.QuestionCount == 1 ? "въпрос" : "въпроса")</span>
                            <a asp-action="Solve" asp-route-id="@item.Quiz.Id" class="btn btn-sm btn-primary">Реши</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Страници с упражнения" class="mt-4">
            <ul class="pagination justify-content-center flex-wrap">
                <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" aria-label="Предишна"><i class="bi bi-chevron-left"></i></a>
                </li>
                @for (var p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")" @(p == Model.Page ? "aria-current=page" : "")>
                        <a class="page-link" asp-action="Index" asp-route-page="@p">@p</a>
                    </li>
                }
                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" aria-label="Следваща"><i class="bi bi-chevron-right"></i></a>
                </li>
            </ul>
        </nav>
    }
}
