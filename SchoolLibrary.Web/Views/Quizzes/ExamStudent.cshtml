@model SchoolLibrary.ViewModels.ExamEntryViewModel

@{
    var exam = Model.Exam!;
    ViewData["Title"] = exam.Title;
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1 class="h3 mb-1"><i class="bi bi-stopwatch"></i> @exam.Title</h1>
        <div class="text-body-secondary mb-3">
            @if (!string.IsNullOrEmpty(exam.ClassName))
            {
                <span class="me-2"><i class="bi bi-people"></i> Клас: <strong>@exam.ClassName</strong></span>
            }
            @if (exam.TimeLimitMinutes.HasValue)
            {
                <span><i class="bi bi-clock"></i> @exam.TimeLimitMinutes мин.</span>
            }
        </div>

        @if (!exam.IsOpen)
        {
            <div class="alert alert-warning py-2">
                Изпитът е затворен. Ако вече си го предал, въведи същите име и номер, за да видиш резултата си.
            </div>
        }

        <form method="post" asp-action="ExamStudent">
            <div asp-validation-summary="All" class="text-danger small mb-2"></div>
            <input type="hidden" asp-for="Code" />

            <div class="mb-3">
                <label asp-for="StudentName" class="form-label"></label>
                <input asp-for="StudentName" class="form-control" autocomplete="off" autofocus />
                <span asp-validation-for="StudentName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="StudentNumber" class="form-label"></label>
                <input asp-for="StudentNumber" class="form-control" inputmode="numeric" autocomplete="off" />
                <span asp-validation-for="StudentNumber" class="text-danger small"></span>
                <div class="form-text">Използвай същите име и номер, ако се върнеш, за да продължиш или да видиш резултата.</div>
            </div>

            <button type="submit" class="btn btn-primary">@(exam.IsOpen ? "Започни" : "Виж резултата")</button>
            <a asp-action="Exam" class="btn btn-link">Друг код</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
