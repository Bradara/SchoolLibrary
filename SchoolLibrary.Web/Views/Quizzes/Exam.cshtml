@model SchoolLibrary.ViewModels.ExamEntryViewModel

@{
    ViewData["Title"] = "Изпит по код";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1 class="h3 mb-3"><i class="bi bi-stopwatch"></i> Изпит по код</h1>
        <p class="text-body-secondary">Въведи кода, който учителят ти даде, своето име и номер в класа.</p>

        <form method="post" asp-action="Exam">
            <div asp-validation-summary="All" class="text-danger small mb-2"></div>

            <div class="mb-3">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control form-control-lg text-uppercase" autocomplete="off" autofocus />
                <span asp-validation-for="Code" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="StudentName" class="form-label"></label>
                <input asp-for="StudentName" class="form-control" autocomplete="off" />
                <span asp-validation-for="StudentName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="StudentNumber" class="form-label"></label>
                <input asp-for="StudentNumber" class="form-control" autocomplete="off" />
                <span asp-validation-for="StudentNumber" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary">Започни</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
