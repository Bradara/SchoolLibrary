@model SchoolLibrary.ViewModels.ExamForcedViewModel

@{
    ViewData["Title"] = "Изпитът е предаден принудително";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="alert alert-danger text-center py-5 mb-4" role="alert">
            <i class="bi bi-x-octagon-fill display-3"></i>
            <h1 class="display-6 fw-bold mt-2">Изпитът е предаден принудително</h1>
            <p class="fs-5 mb-0">Причина: опит за преписване — напускане на изпита повече от позволеното.</p>
            <p class="mb-0 mt-2">Учителят вижда, че опитът е маркиран.</p>
        </div>

        <div class="text-center text-body-secondary small mb-3">
            <div>@Model.Title</div>
            <div>Ученик: <strong>@Model.StudentName</strong>@(string.IsNullOrEmpty(Model.ClassName) ? "" : ", " + Model.ClassName)</div>
            @if (Model.SubmittedOn.HasValue)
            {
                <div>Предаден: @Model.SubmittedOn.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
            }
        </div>

        @if (Model.Result != null)
        {
            <partial name="_GradeSummary" model="Model.Result" />
        }
        else
        {
            <p class="text-center text-body-secondary">Резултатът ще се вижда, когато учителят го активира.</p>
        }

        <div class="text-center">
            <a asp-controller="Home" asp-action="Index" class="btn btn-link">← Към началото</a>
        </div>
    </div>
</div>
