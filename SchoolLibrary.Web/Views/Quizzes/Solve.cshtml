@using SchoolLibrary.Services.Quizzes
@model PracticeSet

@{
    var quiz = Model.Quiz;
    ViewData["Title"] = quiz.Title;

    // "Провери" on code questions: a practice is not stored, so the page keeps the count of wrong checks
    ViewData["CodeCheckUrl"] = Url.Action("CheckCode", new { id = quiz.Id });
    ViewData["CodeCheckMode"] = "practice";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Упражнения</a></li>
        <li class="breadcrumb-item active">@quiz.Title</li>
    </ol>
</nav>

<h1>@quiz.Title</h1>
@if (!string.IsNullOrEmpty(quiz.Description))
{
    <p class="lead">@quiz.Description</p>
}

@if (Model.Questions.Count == 0)
{
    <div class="alert alert-warning">Това упражнение още няма въпроси.</div>
}
else
{
    <form method="post" asp-action="Solve" asp-route-id="@quiz.Id">
        @foreach (var question in Model.Questions)
        {
            <input type="hidden" name="questionIds" value="@question.Id" />
        }

        @{
            var questionList = new SchoolLibrary.ViewModels.QuizQuestionListViewModel
            {
                Questions = Model.Questions,
                OneQuestionPerPage = quiz.OneQuestionPerPage,
                SubmitLabel = "Предай упражнението"
            };
        }
        <partial name="_QuizQuestionList" model="questionList" />

        <a asp-action="Index" class="btn btn-link mt-2 px-0">← Към упражненията</a>
    </form>
}

@section Scripts {
    <script src="~/js/sl-code-check.js" asp-append-version="true"></script>
    <script src="~/js/sl-quiz-pager.js" asp-append-version="true"></script>
}
