@using SchoolLibrary.Data.Models
@model Quiz

@{
    ViewData["Title"] = Model.Title;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Упражнения</a></li>
        <li class="breadcrumb-item active">@Model.Title</li>
    </ol>
</nav>

<h1>@Model.Title</h1>
@if (!string.IsNullOrEmpty(Model.Description))
{
    <p class="lead">@Model.Description</p>
}

<form method="post" asp-action="Solve" asp-route-id="@Model.Id">
    @{ var number = 0; }
    @foreach (var question in Model.Questions)
    {
        number++;
        <fieldset class="card mb-3">
            <div class="card-body">
                <legend class="h6 card-title">@number. @question.Text</legend>
                @foreach (var option in question.Options)
                {
                    var optionId = $"q{question.Id}o{option.Id}";
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="answers[@question.Id]" value="@option.Id" id="@optionId">
                        <label class="form-check-label" for="@optionId">@option.Text</label>
                    </div>
                }
            </div>
        </fieldset>
    }

    <button type="submit" class="btn btn-primary">Провери</button>
    <a asp-action="Index" class="btn btn-link">← Към упражненията</a>
</form>
