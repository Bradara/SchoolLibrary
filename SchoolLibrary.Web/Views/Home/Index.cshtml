@{
    ViewData["Title"] = "Начало";
}

<div class="text-center py-5 bg-body-tertiary rounded-3 mb-4">
    <h1 class="display-4 fw-bold">SchoolLibrary</h1>
    <p class="lead col-md-8 mx-auto">
        Онлайн библиотека, където учителите споделят учебни ресурси със своите ученици в едно удобно пространство.
    </p>
    <div class="mt-4 d-flex flex-wrap justify-content-center gap-2">
        <a asp-controller="Resources" asp-action="Index" class="btn btn-primary btn-lg">
            Разгледай ресурсите
        </a>
        <a asp-controller="Quizzes" asp-action="Exam" class="btn btn-outline-primary btn-lg">
            <i class="bi bi-stopwatch"></i> Изпит по код
        </a>
        @if (!(User.Identity?.IsAuthenticated ?? false))
        {
            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-primary btn-lg">
                Регистрирай се
            </a>
        }
        else if (User.CanAddResources())
        {
            <a asp-controller="Resources" asp-action="Create" class="btn btn-outline-primary btn-lg">
                + Добави ресурс
            </a>
        }
    </div>
</div>

<div class="row g-4 row-cols-1 row-cols-md-3">
    <div class="col">
        <div class="sl-feature">
            <div class="sl-feature-icon">📚</div>
            <h4>Споделяй</h4>
            <p class="text-body-secondary mb-0">Качвай полезни линкове към Google Drive, YouTube и други материали.</p>
        </div>
    </div>
    <div class="col">
        <div class="sl-feature">
            <div class="sl-feature-icon">🏷️</div>
            <h4>Организирай</h4>
            <p class="text-body-secondary mb-0">По предмет и клас, с бърз филтър в списъка.</p>
        </div>
    </div>
    <div class="col">
        <div class="sl-feature">
            <div class="sl-feature-icon">👥</div>
            <h4>Намирай</h4>
            <p class="text-body-secondary mb-0">Всички учители виждат публикуваните ресурси.</p>
        </div>
    </div>
</div>