@model SchoolLibrary.ViewModels.FavoritesIndexViewModel

@{
    ViewData["Title"] = "Любими";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-heart-fill text-danger"></i> Любими <small class="fs-6 text-body-secondary">(@Model.TotalCount)</small></h1>
</div>

@if (Model.TotalCount == 0)
{
    <div class="alert alert-info text-center py-5">
        <p>Все още нямате любими ресурси. Натиснете сърцето <i class="bi bi-heart"></i> до ресурс, за да го запазите тук.</p>
        <a asp-controller="Resources" asp-action="Index" class="btn btn-primary">Към ресурсите</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Заглавие</th>
                    <th>Предмети</th>
                    <th>Класове</th>
                    <th>Лиценз</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Resources)
                {
                    <tr>
                        <td>
                            <a asp-controller="Resources" asp-action="Details" asp-route-id="@item.Id" class="fw-bold text-decoration-none">@item.Title</a>
                        </td>
                        <td>@foreach (var c in item.Categories.OrderBy(c => c.Name)) { <span class="badge bg-primary text-primary-emphasis">@c.Name</span> }</td>
                        <td>@foreach (var g in item.GradeLevels.OrderBy(g => g.Number)) { <span class="badge bg-secondary text-secondary-emphasis">@g.Name</span> }</td>
                        <td class="small">@(item.License?.Name ?? "—")</td>
                        <td class="text-end text-nowrap">
                            <div class="d-inline-flex gap-1">
                                <a asp-controller="Resources" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary"
                                   data-sl-tip="Детайли" data-sl-placement="top" aria-label="Детайли"><i class="bi bi-eye"></i></a>
                                <partial name="_FavoriteButton" model="new SchoolLibrary.ViewModels.FavoriteButtonModel(item.Id, true, returnUrl)" />
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Страници с любими">
            <ul class="pagination justify-content-center flex-wrap">
                <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" aria-label="Предишна"><i class="bi bi-chevron-left"></i></a>
                </li>
                @for (var p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")" @(p == Model.Page ? "aria-current=page" : "")>
                        <a class="page-link" asp-action="Index" asp-route-page="@p">@p</a>
                    </li>
                }
                <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" aria-label="Следваща"><i class="bi bi-chevron-right"></i></a>
                </li>
            </ul>
        </nav>
    }
}
