@model SchoolLibrary.ViewModels.ExamSettingsViewModel

<div class="mb-3">
    <label asp-for="TimeLimitMinutes" class="form-label"></label>
    <input asp-for="TimeLimitMinutes" class="form-control" type="number" min="1" max="600" />
    <span asp-validation-for="TimeLimitMinutes" class="text-danger small"></span>
    <div class="form-text">Празно = без ограничение във времето.</div>
</div>

<div class="mb-3">
    <label asp-for="MaxLeaves" class="form-label"></label>
    <input asp-for="MaxLeaves" class="form-control" type="number" min="0" max="100" />
    <span asp-validation-for="MaxLeaves" class="text-danger small"></span>
    <div class="form-text">Колко пъти ученикът може да напусне страницата, преди изпитът да се предаде автоматично. Празно = без надзор.</div>
</div>

<div class="mb-3">
    <div class="form-check">
        <input asp-for="OneQuestionPerPage" class="form-check-input" type="checkbox" />
        <label asp-for="OneQuestionPerPage" class="form-check-label"></label>
    </div>
    <div class="form-text">Ученикът вижда по един въпрос и минава към следващия с бутони или от номерата вдясно. Без отметката всички въпроси са на една страница.</div>
</div>

<div class="mb-3">
    <div class="form-check">
        <input asp-for="CodeHints" class="form-check-input" type="checkbox" />
        <label asp-for="CodeHints" class="form-check-label"></label>
    </div>
    <div class="form-text">При въпросите с код се предлагат ключови думи, често ползвани функции и имената от програмата (Ctrl+Интервал). Упражненията винаги са с подсказки.</div>
</div>
