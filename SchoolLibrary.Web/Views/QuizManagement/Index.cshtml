@using SchoolLibrary.Data.Enums
@using SchoolLibrary.Services.Common
@using SchoolLibrary.Services.Quizzes
@model PagedResult<QuizListItem>

@{
    ViewData["Title"] = "Моите тестове";
}

<partial name="_MessagePartial" />

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-ui-checks"></i> Моите тестове <small class="fs-6 text-body-secondary">(@Model.TotalCount)</small></h1>
</div>

@if (Model.TotalCount == 0)
{
    <div class="alert alert-info text-center py-5">
        <p class="mb-0">Все още нямате тестове.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Заглавие</th>
                    <th>Вид</th>
                    <th>Код</th>
                    <th>Състояние</th>
                    <th class="text-center">Въпроси</th>
                    <th class="text-center">Решения</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">@item.Quiz.Title</td>
                        <td>
                            @if (item.Quiz.Mode == QuizMode.Exam)
                            {
                                <span class="badge text-bg-warning">Изпит</span>
                            }
                            else
                            {
                                <span class="badge text-bg-info">Упражнение</span>
                            }
                        </td>
                        <td>
                            @if (item.Quiz.Mode == QuizMode.Exam && !string.IsNullOrEmpty(item.Quiz.Code))
                            {
                                <code class="user-select-all">@item.Quiz.Code</code>
                            }
                            else
                            {
                                <span class="text-body-secondary">—</span>
                            }
                        </td>
                        <td>
                            @if (item.Quiz.IsPublished)
                            {
                                <span class="badge text-bg-success">Публикуван</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Чернова</span>
                            }
                        </td>
                        <td class="text-center">@item.QuestionCount</td>
                        <td class="text-center">@item.AttemptCount</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Attempts" asp-route-id="@item.Quiz.Id" class="btn btn-sm btn-outline-secondary"
                               data-sl-tip="Решения" data-sl-placement="top" aria-label="Решения"><i class="bi bi-list-check"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Страници с тестове" class="mt-4">
            <ul class="pagination justify-content-center flex-wrap">
                <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" aria-label="Предишна"><i class="bi bi-chevron-left"></i></a>
                </li>
                @for (var p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")" @(p == Model.Page ? "aria-current=page" : "")>
                        <a class="page-link" asp-action="Index" asp-route-page="@p">@p</a>
                    </li>
                }
                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" aria-label="Следваща"><i class="bi bi-chevron-right"></i></a>
                </li>
            </ul>
        </nav>
    }
}
