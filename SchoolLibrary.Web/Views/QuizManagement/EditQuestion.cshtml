@model SchoolLibrary.ViewModels.QuestionFormViewModel

@{
    ViewData["Title"] = "Редакция на въпрос";
    var quizId = ViewBag.QuizId;
    var questionId = ViewBag.QuestionId;
    var rowCount = Math.Min(10, Math.Max(4, Model.Options.Count + 2));
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Моите тестове</a></li>
        <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@quizId">Управление</a></li>
        <li class="breadcrumb-item active">Редакция на въпрос</li>
    </ol>
</nav>

<h1 class="h3 mb-3">Редакция на въпрос</h1>

<div class="row">
    <div class="col-lg-7">
        <form method="post" asp-action="EditQuestion" asp-route-id="@quizId" asp-route-questionId="@questionId">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

            <div class="mb-2">
                <label asp-for="Text" class="form-label"></label>
                <input asp-for="Text" class="form-control" maxlength="1000" />
                <span asp-validation-for="Text" class="text-danger small"></span>
            </div>

            <p class="form-text mb-1">Попълни поне 2 отговора и посочи верния. Празните редове се пропускат.</p>
            @for (var i = 0; i < rowCount; i++)
            {
                var text = i < Model.Options.Count ? Model.Options[i] : string.Empty;
                <div class="input-group mb-2">
                    <div class="input-group-text">
                        <input class="form-check-input mt-0" type="radio" name="CorrectIndex" value="@i"
                               aria-label="Верен отговор @(i + 1)" @(Model.CorrectIndex == i ? "checked" : "") />
                    </div>
                    <input name="Options[@i]" value="@text" class="form-control" maxlength="500" placeholder="Отговор @(i + 1)" />
                </div>
            }

            <button type="submit" class="btn btn-primary">Запази</button>
            <a asp-action="Details" asp-route-id="@quizId" class="btn btn-link">Отказ</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
