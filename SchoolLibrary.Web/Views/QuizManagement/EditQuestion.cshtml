@model SchoolLibrary.ViewModels.QuestionFormViewModel

@{
    ViewData["Title"] = "Редакция на въпрос";
    var quizId = ViewBag.QuizId;
    var questionId = ViewBag.QuestionId;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Моите тестове</a></li>
        <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@quizId">Управление</a></li>
        <li class="breadcrumb-item active">Редакция на въпрос</li>
    </ol>
</nav>

<h1 class="h3 mb-3">Редакция на въпрос</h1>

<partial name="_MessagePartial" />

@if (ViewBag.AnsweredAttempts is int answered && answered > 0)
{
    <div class="alert alert-info small" role="note">
        Въпросът е решаван в @answered @(answered == 1 ? "опит" : "опита"). При запис решенията ще бъдат преоценени
        според промените. Видът на въпроса не може да се смени, а отговор, който е избиран от ученици, не може да се
        премахне (можете да промените текста му или да го направите грешен).
    </div>
}

<div class="row">
    <div class="col-lg-7">
        <form method="post" asp-action="EditQuestion" asp-route-id="@quizId" asp-route-questionId="@questionId" class="question-form">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

            <div class="mb-2">
                <label asp-for="Text" class="form-label"></label>
                <textarea asp-for="Text" class="form-control" maxlength="1000" rows="3"></textarea>
                <span asp-validation-for="Text" class="text-danger small"></span>
            </div>

            <div class="mb-2 qt-points" style="max-width: 9rem;">
                <label asp-for="Points" class="form-label"></label>
                <input asp-for="Points" class="form-control" type="number" min="1" max="100" />
                <span asp-validation-for="Points" class="text-danger small"></span>
            </div>

            <partial name="_QuestionAnswersEditor" model="Model" />

            <button type="submit" class="btn btn-primary">Запази</button>
            <a asp-action="Details" asp-route-id="@quizId" class="btn btn-link">Отказ</a>
        </form>
    </div>
    @if (ViewBag.ImagesPanel is SchoolLibrary.ViewModels.QuestionImagesPanelModel imagesPanel)
    {
        <div class="col-lg-5">
            <partial name="_QuestionImagesPanel" model="imagesPanel" />
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/sl-question-images.js" asp-append-version="true"></script>
}
