@using SchoolLibrary.Data.Enums
@model SchoolLibrary.ViewModels.QuizManageViewModel

@{
    var quiz = Model.Quiz;
    ViewData["Title"] = quiz.Title;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Моите тестове</a></li>
        <li class="breadcrumb-item active">@quiz.Title</li>
    </ol>
</nav>

<partial name="_MessagePartial" />

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
    <h1 class="h3 mb-0">@quiz.Title</h1>
    <div class="d-flex flex-wrap gap-1">
        <a asp-action="Edit" asp-route-id="@quiz.Id" class="btn btn-sm btn-outline-primary">Редактирай</a>
        <a asp-action="Attempts" asp-route-id="@quiz.Id" class="btn btn-sm btn-outline-secondary">Решения</a>
        <form method="post" asp-action="SetPublished" asp-route-id="@quiz.Id" class="d-inline">
            <input type="hidden" name="publish" value="@((!quiz.IsPublished).ToString().ToLowerInvariant())" />
            <button type="submit" class="btn btn-sm @(quiz.IsPublished ? "btn-outline-secondary" : "btn-success")">
                @(quiz.IsPublished ? "Скрий" : "Публикувай")
            </button>
        </form>
        <form method="post" asp-action="Delete" asp-route-id="@quiz.Id" class="d-inline"
              onsubmit="return confirm('Да изтрия ли теста и всички негови решения? Действието е необратимо.');">
            <button type="submit" class="btn btn-sm btn-outline-danger">Изтрий</button>
        </form>
    </div>
</div>

<div class="mb-3">
    @if (quiz.Mode == QuizMode.Exam)
    {
        <span class="badge text-bg-warning">Изпит</span>
    }
    else
    {
        <span class="badge text-bg-info">Упражнение</span>
    }
    @if (quiz.IsPublished)
    {
        <span class="badge text-bg-success">Публикуван</span>
    }
    else
    {
        <span class="badge text-bg-secondary">Чернова</span>
    }
    @if (quiz.Mode == QuizMode.Exam && quiz.TimeLimitMinutes.HasValue)
    {
        <span class="badge text-bg-light">@quiz.TimeLimitMinutes мин.</span>
    }
</div>

@if (quiz.Mode == QuizMode.Exam && !string.IsNullOrEmpty(quiz.Code))
{
    <div class="alert alert-light border">
        Код за учениците: <code class="fs-5 user-select-all">@quiz.Code</code>
        <div class="form-text mb-0">Учениците влизат от „Изпит по код“ с този код, името и номера си.</div>
    </div>
}

@if (!string.IsNullOrEmpty(quiz.Description))
{
    <p class="text-body-secondary">@quiz.Description</p>
}

<h2 class="h5 mt-4">Състав от банката (@Model.Items.Count)</h2>
<p class="form-text mt-0">Въпроси, изтеглени от банката: конкретни или „N произволни от раздел" (разпъват се при всяко влизане на ученик).</p>

@if (Model.Items.Count > 0)
{
    <ol class="list-group list-group-numbered mb-3">
        @foreach (var item in Model.Items)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                @if (item.Kind == QuizItemKind.RandomFromSection)
                {
                    <span><i class="bi bi-shuffle"></i> <strong>@item.PickCount</strong> произволни от раздел: @item.Section?.Name</span>
                }
                else
                {
                    <span><i class="bi bi-pin-angle"></i> @item.Question?.Text</span>
                }
                <span class="d-inline-flex gap-1">
                    <form method="post" asp-action="MoveItem" asp-route-id="@quiz.Id" class="d-inline">
                        <input type="hidden" name="itemId" value="@item.Id" />
                        <input type="hidden" name="up" value="true" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary" aria-label="Нагоре"><i class="bi bi-arrow-up"></i></button>
                    </form>
                    <form method="post" asp-action="MoveItem" asp-route-id="@quiz.Id" class="d-inline">
                        <input type="hidden" name="itemId" value="@item.Id" />
                        <input type="hidden" name="up" value="false" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary" aria-label="Надолу"><i class="bi bi-arrow-down"></i></button>
                    </form>
                    <form method="post" asp-action="DeleteItem" asp-route-id="@quiz.Id" class="d-inline">
                        <input type="hidden" name="itemId" value="@item.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Премахни"><i class="bi bi-trash"></i></button>
                    </form>
                </span>
            </li>
        }
    </ol>
}

@if (Model.Sections.Count == 0)
{
    <div class="alert alert-light border">Създай раздели и въпроси в <a asp-controller="Sections" asp-action="Index">Банката с въпроси</a>, за да съставяш оттам.</div>
}
else
{
    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <form method="post" asp-action="AddRandomItem" asp-route-id="@quiz.Id" class="card h-100">
                <div class="card-body">
                    <h3 class="h6">Произволни от раздел</h3>
                    <div class="input-group">
                        <select name="sectionId" class="form-select" aria-label="Раздел">
                            @foreach (var sec in Model.Sections)
                            {
                                <option value="@sec.Id">@sec.Name</option>
                            }
                        </select>
                        <input name="pickCount" type="number" min="1" max="100" value="1" class="form-control" style="max-width: 6rem;" aria-label="Брой" />
                        <button type="submit" class="btn btn-outline-primary">Добави</button>
                    </div>
                </div>
            </form>
        </div>
        <div class="col-md-6">
            <form method="post" asp-action="AddFixedItem" asp-route-id="@quiz.Id" class="card h-100">
                <div class="card-body">
                    <h3 class="h6">Конкретен въпрос</h3>
                    @if (Model.BankQuestions.Count == 0)
                    {
                        <p class="form-text mb-0">Няма въпроси в банката.</p>
                    }
                    else
                    {
                        <div class="input-group">
                            <select name="questionId" class="form-select" aria-label="Въпрос">
                                @foreach (var group in Model.BankQuestions.GroupBy(q => q.Section!.Name))
                                {
                                    <optgroup label="@group.Key">
                                        @foreach (var question in group)
                                        {
                                            <option value="@question.Id">@question.Text</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                            <button type="submit" class="btn btn-outline-primary">Добави</button>
                        </div>
                    }
                </div>
            </form>
        </div>
    </div>
}

@if (quiz.Questions.Any())
{
    <h2 class="h5 mt-4">Стари преки въпроси (@quiz.Questions.Count)</h2>
    <p class="form-text mt-0">Добавени само към този тест (преди банката). Влизат в теста заедно със състава от банката. Новите въпроси се създават в банката.</p>

    var number = 0;
    foreach (var question in quiz.Questions)
    {
        number++;
        <div class="card mb-2">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <h3 class="h6 mb-1">@number. @question.Text <span class="badge text-bg-light">@question.Points т.</span></h3>
                    <div class="d-inline-flex gap-1">
                        <a asp-action="EditQuestion" asp-route-id="@quiz.Id" asp-route-questionId="@question.Id"
                           class="btn btn-sm btn-outline-primary" aria-label="Редактирай въпроса"><i class="bi bi-pencil"></i></a>
                        <form method="post" asp-action="DeleteQuestion" asp-route-id="@quiz.Id" class="d-inline"
                              onsubmit="return confirm('Да изтрия ли въпроса?');">
                            <input type="hidden" name="questionId" value="@question.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Изтрий въпроса"><i class="bi bi-trash"></i></button>
                        </form>
                    </div>
                </div>
                <ul class="list-unstyled mb-0">
                    @foreach (var option in question.Options)
                    {
                        <li class="@(option.IsCorrect ? "text-success fw-semibold" : "")">
                            @if (option.IsCorrect)
                            {
                                <i class="bi bi-check-circle-fill"></i>
                            }
                            else
                            {
                                <i class="bi bi-circle"></i>
                            }
                            @option.Text
                        </li>
                    }
                </ul>
            </div>
        </div>
    }
}

@{
    var newQuestion = Model.NewQuestion;
    var rowCount = Math.Min(10, Math.Max(4, newQuestion.Options.Count));
    var points = newQuestion.Points < 1 ? 1 : newQuestion.Points;
}
<div class="card mt-3">
    <div class="card-body">
        <h2 class="h6 card-title">Нов въпрос (в банката и към теста)</h2>
        <form method="post" asp-action="AddQuestion" asp-route-id="@quiz.Id">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
            <div class="mb-2">
                <input name="Text" value="@newQuestion.Text" class="form-control" maxlength="1000" placeholder="Текст на въпроса" required />
            </div>
            <div class="mb-2" style="max-width: 9rem;">
                <label class="form-label small mb-0" for="q-points">Точки</label>
                <input id="q-points" name="Points" type="number" min="1" max="100" value="@points" class="form-control" />
            </div>
            <p class="form-text mb-1">Попълни поне 2 отговора и посочи верния. Празните редове се пропускат.</p>
            @for (var i = 0; i < rowCount; i++)
            {
                var optionText = i < newQuestion.Options.Count ? newQuestion.Options[i] : string.Empty;
                <div class="input-group mb-2">
                    <div class="input-group-text">
                        <input class="form-check-input mt-0" type="radio" name="CorrectIndex" value="@i"
                               aria-label="Верен отговор @(i + 1)" @(newQuestion.CorrectIndex == i ? "checked" : "") />
                    </div>
                    <input name="Options[@i]" value="@optionText" class="form-control" maxlength="500" placeholder="Отговор @(i + 1)" />
                </div>
            }
            <button type="submit" class="btn btn-primary">Добави въпрос</button>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-link">← Към тестовете</a>
</div>
