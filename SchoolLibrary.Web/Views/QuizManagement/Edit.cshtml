@model SchoolLibrary.ViewModels.QuizFormViewModel

@{
    ViewData["Title"] = "Редакция на тест";
    var quizId = ViewContext.RouteData.Values["id"];
}

<h1 class="h3 mb-3">Редакция на тест</h1>

<div class="row">
    <div class="col-lg-7">
        <form method="post" asp-action="Edit" asp-route-id="@quizId">
            <partial name="_QuizForm" model="Model" />
            <button type="submit" class="btn btn-primary">Запази</button>
            <a asp-action="Details" asp-route-id="@quizId" class="btn btn-link">Отказ</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
