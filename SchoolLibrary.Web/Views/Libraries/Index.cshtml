@model IReadOnlyList<SchoolLibrary.Data.Models.OnlineLibrary>

@{
    ViewData["Title"] = "Библиотеки";
}

<h1 class="mb-2">📚 Онлайн библиотеки</h1>
<p class="text-muted mb-4">
    Подбрани външни библиотеки с книги и материали за четене. Връзките се отварят в нов раздел на сайта на съответната библиотека.
</p>

@if (Model.Count == 0)
{
    <div class="alert alert-info text-center py-5">Все още няма добавени библиотеки.</div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 g-4">
        @foreach (var library in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <span class="d-inline-flex align-items-center justify-content-center rounded-3 bg-primary-subtle text-primary-emphasis flex-shrink-0"
                                  style="width: 3.5rem; height: 3.5rem; font-size: 1.75rem;" aria-hidden="true">
                                <partial name="_LibraryIcon" model="library" />
                            </span>
                            <div class="min-w-0">
                                <h2 class="h5 card-title mb-0">@library.Name</h2>
                                @if (library.Host != null)
                                {
                                    <div class="small text-muted text-truncate">@library.Host</div>
                                }
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(library.Description))
                        {
                            <p class="card-text text-muted">@library.Description</p>
                        }
                        @if (library.SafeUrl != null)
                        {
                            <div class="mt-auto pt-2">
                                <a href="@library.SafeUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary stretched-link">
                                    Към библиотеката <i class="bi bi-box-arrow-up-right"></i>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
