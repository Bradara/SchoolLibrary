@model SchoolLibrary.ViewModels.SectionManageViewModel

@{
    var topic = Model.Section;
    ViewData["Title"] = topic.Name;
    var newQuestion = Model.NewQuestion;
    var points = newQuestion.Points < 1 ? 1 : newQuestion.Points;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Банка с въпроси</a></li>
        @foreach (var ancestor in Model.Ancestors)
        {
            <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@ancestor.Id">@ancestor.Name</a></li>
        }
        <li class="breadcrumb-item active">@topic.Name</li>
    </ol>
</nav>

<partial name="_MessagePartial" />

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
    <h1 class="h3 mb-0">@topic.Name</h1>
    <div class="d-flex flex-wrap gap-1">
        <a asp-action="Edit" asp-route-id="@topic.Id" class="btn btn-sm btn-outline-primary">Редактирай</a>
        <form method="post" asp-action="Delete" asp-route-id="@topic.Id" class="d-inline"
              onsubmit="return confirm('Да изтрия ли раздела? Трябва да е празен.');">
            <button type="submit" class="btn btn-sm btn-outline-danger">Изтрий</button>
        </form>
    </div>
</div>

@if (!string.IsNullOrEmpty(topic.Description))
{
    <p class="text-body-secondary">@topic.Description</p>
}

<div class="d-flex justify-content-between align-items-center mt-4">
    <h2 class="h5 mb-0">Подраздели (@Model.Subsections.Count)</h2>
    <a asp-action="Create" asp-route-parentId="@topic.Id" class="btn btn-sm btn-outline-primary">+ Нов подраздел</a>
</div>
@if (Model.Subsections.Count > 0)
{
    <ul class="list-group mt-2">
        @foreach (var sub in Model.Subsections)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <a asp-action="Details" asp-route-id="@sub.Section.Id" class="text-decoration-none">
                    <i class="bi bi-folder"></i> @sub.Section.Name
                </a>
                <span class="small text-body-secondary">@sub.QuestionCount въпр. · @sub.ChildCount подр.</span>
            </li>
        }
    </ul>
}

<h2 class="h5 mt-4">Въпроси (@Model.Questions.Count)</h2>

@if (Model.Questions.Count == 0)
{
    <div class="alert alert-warning">Няма въпроси в този раздел.</div>
}
else
{
    var canMove = Model.TargetSections.Count > 0;
    if (canMove)
    {
        <form id="moveForm" method="post" asp-action="MoveQuestions" asp-route-id="@topic.Id"
              class="card card-body py-2 mb-2"
              onsubmit="return this.querySelectorAll('input[name=questionIds]:checked').length > 0 || (alert('Изберете поне един въпрос.'), false);">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="small text-body-secondary">Отметни въпроси и ги премести в:</span>
                <select name="targetSectionId" class="form-select form-select-sm" style="max-width: 20rem;" aria-label="Целеви раздел">
                    @foreach (var target in Model.TargetSections)
                    {
                        <option value="@target.Id">@target.Name</option>
                    }
                </select>
                <button type="submit" class="btn btn-sm btn-outline-primary">Премести избраните</button>
            </div>
        </form>
    }

    var number = 0;
    foreach (var question in Model.Questions)
    {
        number++;
        <div class="card mb-2">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <h3 class="h6 mb-1 d-flex align-items-start gap-2">
                        @if (canMove)
                        {
                            <input class="form-check-input mt-1 flex-shrink-0" type="checkbox" name="questionIds"
                                   value="@question.Id" form="moveForm" aria-label="Избери въпроса" />
                        }
                        <span>@number. @question.Text <span class="badge text-bg-light">@question.Points т.</span><partial name="_QuestionTypeBadge" model="question" /></span>
                    </h3>
                    <div class="d-inline-flex gap-1">
                        <a asp-action="EditQuestion" asp-route-id="@topic.Id" asp-route-questionId="@question.Id"
                           class="btn btn-sm btn-outline-primary" aria-label="Редактирай въпроса"><i class="bi bi-pencil"></i></a>
                        <form method="post" asp-action="DeleteQuestion" asp-route-id="@topic.Id" class="d-inline"
                              onsubmit="return confirm('Да изтрия ли въпроса?');">
                            <input type="hidden" name="questionId" value="@question.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Изтрий въпроса"><i class="bi bi-trash"></i></button>
                        </form>
                    </div>
                </div>
                <partial name="_QuestionOptionsList" model="question" />
            </div>
        </div>
    }
}

<div class="card mt-3">
    <div class="card-body">
        <h2 class="h6 card-title">Нов въпрос</h2>
        <form method="post" asp-action="AddQuestion" asp-route-id="@topic.Id" class="question-form">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
            <div class="mb-2">
                <input name="Text" value="@newQuestion.Text" class="form-control" maxlength="1000" placeholder="Текст на въпроса" required />
            </div>
            <div class="mb-2" style="max-width: 9rem;">
                <label class="form-label small mb-0" for="q-points">Точки</label>
                <input id="q-points" name="Points" type="number" min="1" max="100" value="@points" class="form-control" />
            </div>
            <partial name="_QuestionAnswersEditor" model="newQuestion" />
            <button type="submit" class="btn btn-primary">Добави въпрос</button>
        </form>
    </div>
</div>

<div class="card mt-3">
    <div class="card-body">
        <h2 class="h6 card-title">Импорт на въпроси</h2>
        <p class="form-text mt-0">Поставете въпроси във формат Aiken или Moodle XML, за да ги налеете наведнъж в раздела. Форматът се разпознава автоматично.</p>
        <form method="post" asp-action="Import" asp-route-id="@topic.Id" enctype="multipart/form-data">
            <textarea name="importText" class="form-control font-monospace" rows="8" spellcheck="false"
                      placeholder="Колко е 2 + 2?&#10;A. 3&#10;B. 4&#10;C. 5&#10;ANSWER: B"></textarea>
            <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                <button type="submit" class="btn btn-outline-primary">Импортирай</button>
                <span class="text-body-secondary small">или качи файл:</span>
                <input type="file" name="importFile" accept=".txt,.xml,text/plain,text/xml,application/xml" class="form-control form-control-sm" style="max-width: 18rem;" />
            </div>
            <div class="form-text">Качен файл има предимство пред текста. Поддържат се .txt (Aiken) и .xml (Moodle).</div>
        </form>
        <details class="mt-2">
            <summary class="small text-body-secondary">Формат Aiken</summary>
            <pre class="small mb-0">Текст на въпроса на отделен ред
A. първи отговор
B. втори отговор
C. трети отговор
ANSWER: B

(празен ред разделя въпросите)</pre>
        </details>
        <details class="mt-2">
            <summary class="small text-body-secondary">Формат Moodle XML</summary>
            <p class="small text-body-secondary mt-1 mb-0">
                Поддържат се въпроси с един верен отговор (<code>multichoice</code> с <code>&lt;single&gt;true&lt;/single&gt;</code>;
                верен е отговорът с най-висок <code>fraction</code>), с няколко верни (<code>&lt;single&gt;false&lt;/single&gt;</code>;
                дяловете <code>fraction</code> се запазват), „Вярно/Невярно“ (<code>truefalse</code>) и кратък отговор
                (<code>shortanswer</code>; приемливите отговори с дяловете им и <code>usecase</code>). Останалите типове се пропускат.
            </p>
        </details>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-link">← Към разделите</a>
</div>
