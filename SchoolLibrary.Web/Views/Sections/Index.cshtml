@using SchoolLibrary.Services.Common
@using SchoolLibrary.Services.Quizzes
@model PagedResult<SectionListItem>

@{
    ViewData["Title"] = "Банка с въпроси";
}

<partial name="_MessagePartial" />

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-collection"></i> Банка с въпроси <small class="fs-6 text-body-secondary">(@Model.TotalCount)</small></h1>
    <a asp-action="Create" class="btn btn-primary">+ Нов раздел</a>
</div>

@if (Model.TotalCount == 0)
{
    <div class="alert alert-info text-center py-5">
        <p class="mb-3">Все още нямате раздели. Разделите групират въпросите по тема; от тях куизовете черпят въпроси.</p>
        <a asp-action="Create" class="btn btn-primary">Създай първия</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Раздел</th>
                    <th class="text-center">Въпроси</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">
                            <a asp-action="Details" asp-route-id="@item.Section.Id" class="text-decoration-none">@item.Section.Name</a>
                            @if (item.ChildCount > 0)
                            {
                                <span class="badge text-bg-light">@item.ChildCount подр.</span>
                            }
                            @if (!string.IsNullOrEmpty(item.Section.Description))
                            {
                                <div class="small text-body-secondary fw-normal">@item.Section.Description</div>
                            }
                        </td>
                        <td class="text-center">@item.QuestionCount</td>
                        <td class="text-end text-nowrap">
                            <div class="d-inline-flex gap-1">
                                <a asp-action="Details" asp-route-id="@item.Section.Id" class="btn btn-sm btn-outline-primary"
                                   data-sl-tip="Въпроси" data-sl-placement="top" aria-label="Въпроси"><i class="bi bi-list-ul"></i></a>
                                <a asp-action="Edit" asp-route-id="@item.Section.Id" class="btn btn-sm btn-outline-secondary"
                                   data-sl-tip="Редактирай" data-sl-placement="top" aria-label="Редактирай"><i class="bi bi-pencil"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Страници с раздели" class="mt-4">
            <ul class="pagination justify-content-center flex-wrap">
                <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" aria-label="Предишна"><i class="bi bi-chevron-left"></i></a>
                </li>
                @for (var p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")" @(p == Model.Page ? "aria-current=page" : "")>
                        <a class="page-link" asp-action="Index" asp-route-page="@p">@p</a>
                    </li>
                }
                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" aria-label="Следваща"><i class="bi bi-chevron-right"></i></a>
                </li>
            </ul>
        </nav>
    }
}
