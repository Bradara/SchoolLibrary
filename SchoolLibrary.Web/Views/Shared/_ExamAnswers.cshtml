@using SchoolLibrary.Services.Quizzes
@model QuizResult
@* The per-question breakdown of a graded attempt (practice, exam result and the teacher's review).
   ViewData["ChosenLabel"] names the student's answer ("твоят отговор" for the student, "отговор на
   ученика" for the teacher). Correct options are green; a wrong pick is red; a correct option the
   student did not tick (multiple choice) is shown with an outline icon and "пропуснат". Short-answer and
   numerical questions show the typed text and the accepted answers instead of an option list; a matching
   question shows each item with the picked answer and, when it is wrong, the right one. *@
@{
    var chosenLabel = ViewData["ChosenLabel"] as string ?? "твоят отговор";
}

@{ var number = 0; }
@foreach (var questionResult in Model.Questions)
{
    if (questionResult.IsDescription)
    {
        <partial name="_QuestionDescription" model="questionResult.Question" />
        continue;
    }

    number++;
    var border = questionResult.IsCorrect ? "success" : questionResult.IsPartial ? "warning" : "danger";
    <div class="card mb-3 border-@border">
        <div class="card-body">
            <h2 class="h6 card-title">
                @number. @questionResult.Question.Text
                @if (questionResult.IsCorrect)
                {
                    <span class="badge text-bg-success">Вярно</span>
                }
                else if (questionResult.IsPartial)
                {
                    <span class="badge text-bg-warning">Частично</span>
                }
                else
                {
                    <span class="badge text-bg-danger">Грешно</span>
                }
                <span class="badge text-bg-light">@QuizPoints.Format(questionResult.AwardedPoints) / @questionResult.Question.Points т.</span>
            </h2>
            @if (questionResult.IsCode)
            {
                <partial name="_CodeAnswerReview" model="questionResult" />
            }
            else if (questionResult.Question.Type == SchoolLibrary.Data.Enums.QuestionType.Matching)
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var item in MatchingAnswers.Items(questionResult.Question))
                    {
                        var picked = questionResult.PickedMatch(item.Id);
                        var right = string.Equals(picked, item.MatchText, StringComparison.Ordinal);
                        <li class="mb-1">
                            @if (right)
                            {
                                <i class="bi bi-check-circle-fill text-success"></i>
                            }
                            else
                            {
                                <i class="bi bi-x-circle-fill text-danger"></i>
                            }
                            @item.Text →
                            @if (picked != null)
                            {
                                <span class="fw-semibold @(right ? "text-success" : "text-danger")">@picked</span>
                            }
                            else
                            {
                                <span class="fst-italic text-body-secondary">без отговор</span>
                            }
                            @if (!right)
                            {
                                <span class="small text-body-secondary">(вярно: <span class="text-success fw-semibold">@item.MatchText</span>)</span>
                            }
                        </li>
                    }
                </ul>
            }
            else if (questionResult.Question.Type is SchoolLibrary.Data.Enums.QuestionType.ShortAnswer
                 or SchoolLibrary.Data.Enums.QuestionType.Numerical)
            {
                var isNumerical = questionResult.Question.Type == SchoolLibrary.Data.Enums.QuestionType.Numerical;
                var typedClass = questionResult.IsCorrect ? "text-success" : questionResult.IsPartial ? "text-warning-emphasis" : "text-danger";
                <div class="mb-1">
                    <span class="text-body-secondary">@(char.ToUpper(chosenLabel[0]) + chosenLabel[1..]):</span>
                    @if (questionResult.TypedText != null)
                    {
                        <span class="fw-semibold @typedClass">@questionResult.TypedText</span>
                    }
                    else
                    {
                        <span class="fst-italic text-body-secondary">без отговор</span>
                    }
                </div>
                <div class="small">
                    <span class="text-body-secondary">Приемливи отговори:</span>
                    @foreach (var accepted in questionResult.Question.Options.Where(QuestionResult.Credits).OrderBy(o => o.Order))
                    {
                        <span class="badge text-bg-success-subtle text-success-emphasis border border-success-subtle me-1">
                            @if (isNumerical)
                            {
                                @NumericAnswer.Display(accepted.Text)
                                @if (accepted.Text != NumericAnswer.AnyNumber && accepted.Tolerance > 0)
                                {
                                    <text> ± @NumericAnswer.Display(accepted.Tolerance.Value)</text>
                                }
                            }
                            else
                            {
                                @accepted.Text
                            }
                        </span>
                    }
                </div>
            }
            else
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var option in questionResult.Question.Options)
                    {
                        var isCorrect = QuestionResult.Credits(option);
                        var isChosen = questionResult.IsChosen(option.Id);
                        <li class="@(isCorrect ? "text-success fw-semibold" : isChosen ? "text-danger" : "")">
                            @if (isCorrect && isChosen)
                            {
                                <i class="bi bi-check-circle-fill"></i>
                            }
                            else if (isCorrect)
                            {
                                <i class="bi bi-check-circle"></i>
                            }
                            else if (isChosen)
                            {
                                <i class="bi bi-x-circle-fill"></i>
                            }
                            else
                            {
                                <i class="bi bi-circle"></i>
                            }
                            @option.Text
                            @if (isChosen && !isCorrect)
                            {
                                <span class="small text-body-secondary fw-normal">(@chosenLabel)</span>
                            }
                            else if (isCorrect && !isChosen && questionResult.Question.Type == SchoolLibrary.Data.Enums.QuestionType.MultipleChoice)
                            {
                                <span class="small text-body-secondary fw-normal">(пропуснат)</span>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
}
