@using SchoolLibrary.Services.CodeRunning
@model SchoolLibrary.Data.Models.Question
@* The answer box of a code question while solving, posted as code[questionId]. Only the tests marked as
   examples are shown (input and expected output); the other tests, hidden or not, never reach the page. *@
@{
    var codeId = $"q{Model.Id}code";
    var language = CodeLanguages.All.TryGetValue(Model.CodeLanguage ?? string.Empty, out var name) ? name : Model.CodeLanguage;
    var examples = Model.TestCases.Where(t => t.IsExample).OrderBy(t => t.Order).ToList();
}

@if (!string.IsNullOrEmpty(Model.Statement))
{
    <div class="mb-3" style="white-space: pre-line;">@Model.Statement</div>
}

@if (examples.Count > 0)
{
    <div class="table-responsive mb-2">
        <table class="table table-sm table-bordered align-top mb-0 small">
            <caption class="caption-top pt-0">Примери</caption>
            <thead>
                <tr>
                    <th scope="col">Вход</th>
                    <th scope="col">Очакван изход</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var example in examples)
                {
                    <tr>
                        <td><pre class="mb-0">@example.Stdin</pre></td>
                        <td><pre class="mb-0">@example.Expected</pre></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<label class="form-label small text-body-secondary mb-1" for="@codeId">Вашата програма (@language)</label>
<textarea class="form-control font-monospace" name="code[@Model.Id]" id="@codeId" rows="12" maxlength="10000"
          spellcheck="false" autocomplete="off" autocapitalize="off" wrap="off"
          data-code-editor data-code-language="@Model.CodeLanguage">@Model.AnswerPreload</textarea>
<p class="form-text mb-0">Програмата чете от стандартния вход и печата на стандартния изход.</p>

@* "Провери" (sl-code-check.js): the including page sets ViewData["CodeCheckUrl"] and ViewData["CodeCheckMode"]
   ("practice" or "exam"); an exam also passes the wrong checks made so far in ViewData["CodeWrongChecks"]. *@
@if (ViewData["CodeCheckUrl"] is string checkUrl)
{
    var practice = (ViewData["CodeCheckMode"] as string) == "practice";
    var wrongSoFar = (ViewData["CodeWrongChecks"] as IReadOnlyDictionary<int, int>)?.GetValueOrDefault(Model.Id) ?? 0;
    var penaltyPoints = SchoolLibrary.Services.Quizzes.QuizPoints.Format(SchoolLibrary.Services.Quizzes.CodePenalty.For(Model, 1));
    <div class="mt-2" data-code-check data-url="@checkUrl" data-question-id="@Model.Id" data-code-id="@codeId">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
            <button type="button" class="btn btn-primary fw-semibold px-3 shadow-sm" data-code-check-button>
                <i class="bi bi-play-fill" aria-hidden="true"></i> <span data-code-check-label>Провери</span>
            </button>
            <span class="small text-body-secondary" data-code-check-count data-wrong="@wrongSoFar" aria-live="polite">Грешни проверки: @wrongSoFar</span>
        </div>
        @if (Model.CheckPenaltyPercent > 0)
        {
            <p class="form-text mt-0 mb-2">
                Всяка грешна проверка отнема @Model.CheckPenaltyPercent% от точките на въпроса (@penaltyPoints т.).
            </p>
        }
        @if (practice)
        {
            <input type="hidden" name="wrongChecks[@Model.Id]" value="@wrongSoFar" data-code-check-wrong />
        }
        <div data-code-check-result aria-live="polite"></div>
    </div>
}
