@* The icon of a subject in its color. The values are checked again here: they go into a class attribute and a CSS variable *@
@model SchoolLibrary.Data.Models.Category
@{
    var (icon, color) = SchoolLibrary.ViewModels.SubjectLook.Of(Model);
}
<span class="subject-icon" style="--subj:@color" aria-hidden="true"><i class="bi @icon"></i></span>
