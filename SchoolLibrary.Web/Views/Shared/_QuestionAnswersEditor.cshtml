@using SchoolLibrary.Data.Enums
@model SchoolLibrary.ViewModels.QuestionFormViewModel
@*
    The type picker and the answer fields of a question form. The form must carry the "question-form"
    class: CSS (site.css) shows only the fields of the picked type, so no script is needed. Hidden fields
    are still posted, but the view model reads only the fields of the picked type.
    - Single choice: option rows with a radio for the one correct option (.qt-single).
    - Multiple choice: the same rows with a checkbox per correct option (.qt-multi).
    - True/false: a pick between "Вярно" and "Невярно" (.qt-truefalse); the option rows are hidden (.qt-options).
    - Short answer: the option rows hold the accepted answers (.qt-short); the marker column is hidden (.qt-mark).
    - Numerical: the option rows hold the accepted values, each with a tolerance field (.qt-numeric); no marker.
    - Matching: each option row is an item with its answer on the right (.qt-matching); no marker.
*@
@{
    var rowCount = Math.Min(10, Math.Max(4, Model.Options.Count + 2));
    var types = new[]
    {
        (Type: QuestionType.SingleChoice, Id: "qt-single", Label: "Един верен отговор"),
        (Type: QuestionType.MultipleChoice, Id: "qt-multi", Label: "Няколко верни"),
        (Type: QuestionType.TrueFalse, Id: "qt-truefalse", Label: "Вярно / Невярно"),
        (Type: QuestionType.ShortAnswer, Id: "qt-shortanswer", Label: "Кратък отговор"),
        (Type: QuestionType.Numerical, Id: "qt-numerical", Label: "Число"),
        (Type: QuestionType.Matching, Id: "qt-matching", Label: "Съпоставяне")
    };
    var customSharesPanel = Model.Type switch
    {
        QuestionType.ShortAnswer => "qt-short",
        QuestionType.Numerical => "qt-numeric",
        _ => "qt-multi"
    };
}

<fieldset class="mb-2">
    <legend class="form-label fs-6 mb-1">Вид на въпроса</legend>
    <div class="btn-group flex-wrap" role="group">
        @foreach (var type in types)
        {
            <input type="radio" class="btn-check" name="Type" id="@type.Id" value="@type.Type"
                   autocomplete="off" @(Model.Type == type.Type ? "checked" : "") />
            <label class="btn btn-sm btn-outline-secondary" for="@type.Id">@type.Label</label>
        }
    </div>
</fieldset>

<div class="qt-options">
    <p class="form-text mb-1 qt-single">Попълни поне 2 отговора и посочи верния. Празните редове се пропускат.</p>
    <p class="form-text mb-1 qt-multi">
        Попълни поне 2 отговора и отметни всички верни. Верните си делят точките поравно, а всеки отметнат
        грешен отговор отнема същия дял (резултатът за въпроса не пада под 0). Празните редове се пропускат.
    </p>
    <p class="form-text mb-1 qt-short">
        Въведи приемливите отговори (всеки носи всички точки). Сравнението пренебрегва излишните интервали,
        малките и главните букви (освен ако не е отметнато по-долу) и латинските букви, които изглеждат като
        кирилски. <code>*</code> замества произволен текст
        (напр. <code>*София*</code>), а <code>\*</code> е самата звездичка. Празните редове се пропускат.
    </p>
    <p class="form-text mb-1 qt-numeric">
        Въведи приемливите числа (всяко носи всички точки) и до всяко — допустимото отклонение (толеранс):
        например 3,14 с толеранс 0,01 приема всичко от 3,13 до 3,15. Празен толеранс означава точно това число.
        Може запетая или точка. <code>*</code> приема всяко число. Празните редове се пропускат.
    </p>
    <p class="form-text mb-1 qt-matching">
        Попълни поне 2 двойки: вляво елемент, вдясно отговорът към него. Ученикът избира отговора от списък с
        всички отговори вдясно. Ред само с отговор вдясно (без елемент) добавя грешен отговор в списъка, за да не
        се налучква. Точките се делят поравно между елементите. Празните редове се пропускат.
    </p>
    <div class="form-check mb-2 qt-short">
        <input class="form-check-input" type="checkbox" name="CaseSensitive" id="q-case-sensitive" value="true"
               @(Model.CaseSensitive ? "checked" : "") />
        <label class="form-check-label" for="q-case-sensitive">Различавай малки и главни букви</label>
    </div>
    @if (Model.HasCustomShares)
    {
        <div class="alert alert-warning py-2 small @customSharesPanel" role="note">
            Този въпрос има собствени дялове за отговорите (например от Moodle). При запис те ще бъдат заменени
            (@(Model.Type is QuestionType.ShortAnswer or QuestionType.Numerical ? "всеки приемлив отговор ще носи всички точки" : "равни части")).
        </div>
    }
    @for (var i = 0; i < rowCount; i++)
    {
        var text = i < Model.Options.Count ? Model.Options[i] : string.Empty;
        var tolerance = i < Model.Tolerances.Count ? Model.Tolerances[i] : string.Empty;
        var match = i < Model.Matches.Count ? Model.Matches[i] : string.Empty;
        <div class="input-group mb-2">
            <div class="input-group-text qt-mark">
                <input class="form-check-input mt-0 qt-single" type="radio" name="CorrectIndex" value="@i"
                       aria-label="Верен отговор @(i + 1)" @(Model.CorrectIndex == i ? "checked" : "") />
                <input class="form-check-input mt-0 qt-multi" type="checkbox" name="CorrectIndexes" value="@i"
                       aria-label="Отговор @(i + 1) е верен" @(Model.CorrectIndexes.Contains(i) ? "checked" : "") />
            </div>
            <input name="Options[@i]" value="@text" class="form-control" maxlength="500" placeholder="Отговор @(i + 1)" />
            <span class="input-group-text qt-matching" aria-hidden="true">→</span>
            <input name="Matches[@i]" value="@match" class="form-control qt-matching" maxlength="500"
                   placeholder="Отговор към него" aria-label="Отговор към ред @(i + 1)" />
            <span class="input-group-text qt-numeric">±</span>
            <input name="Tolerances[@i]" value="@tolerance" class="form-control qt-numeric" maxlength="50" inputmode="decimal"
                   placeholder="толеранс" aria-label="Толеранс на отговор @(i + 1)" style="max-width: 9rem;" />
        </div>
    }
</div>

<fieldset class="qt-truefalse mb-2">
    <legend class="form-text fs-6 mb-1">Твърдението е:</legend>
    <div class="form-check form-check-inline">
        <input class="form-check-input" type="radio" name="TrueFalseAnswer" id="tf-true" value="true"
               @(Model.TrueFalseAnswer == true ? "checked" : "") />
        <label class="form-check-label" for="tf-true">Вярно</label>
    </div>
    <div class="form-check form-check-inline">
        <input class="form-check-input" type="radio" name="TrueFalseAnswer" id="tf-false" value="false"
               @(Model.TrueFalseAnswer == false ? "checked" : "") />
        <label class="form-check-label" for="tf-false">Невярно</label>
    </div>
</fieldset>
