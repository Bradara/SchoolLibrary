@using SchoolLibrary.Data.Enums
@using SchoolLibrary.Services.Resources
@model IReadOnlyCollection<ResourceAudience>
@* Who may see a resource: quick presets plus one toggle per role group. Posts "Audience" values;
   the hidden "None" is always sent, so ticking nothing means "only me". site.js wires the presets. *@
<div class="sl-audience">
    <input type="hidden" name="Audience" value="None" />
    <div class="d-flex flex-wrap gap-2 mb-2" role="group" aria-label="Бърз избор на видимост">
        <button type="button" class="btn btn-sm btn-outline-secondary" data-sl-audience-preset="Guests,Students,Parents,Teachers">
            <i class="bi bi-globe"></i> Всички
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-sl-audience-preset="Students,Parents,Teachers">
            <i class="bi bi-person-check"></i> Само регистрирани
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-sl-audience-preset="Teachers">
            <i class="bi bi-mortarboard"></i> Само учители
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-sl-audience-preset="">
            <i class="bi bi-lock"></i> Само аз
        </button>
    </div>
    <div class="border rounded p-2 d-flex flex-wrap gap-2">
        @foreach (var (group, name) in ResourceVisibility.Groups)
        {
            <input class="btn-check" type="checkbox" name="Audience" autocomplete="off"
                   value="@group" id="audience-@group" checked="@Model.Contains(group)" />
            <label class="btn btn-sm btn-outline-primary" for="audience-@group">@name</label>
        }
    </div>
    <div class="form-text">
        Изберете кои групи виждат материала. Вие винаги виждате своите материали, а администраторите — всички.
        Без отметка материалът е само за вас.
    </div>
</div>
