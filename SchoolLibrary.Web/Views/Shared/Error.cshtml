@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="text-center py-5">
    <i class="bi @Model.Icon display-1 text-body-secondary"></i>
    <div class="display-3 fw-bold mt-3">@Model.StatusCode</div>
    <h1 class="h2 mt-2">@Model.Title</h1>
    <p class="lead">@Model.Message</p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">
            Номер на заявката: <code>@Model.RequestId</code>
        </p>
    }

    <div class="d-flex flex-wrap justify-content-center gap-2 mt-4">
        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-house"></i> Върни се в началото
        </a>
        @if (Model.IsNotFound)
        {
            <a asp-area="" asp-controller="Resources" asp-action="Index" class="btn btn-outline-primary">
                <i class="bi bi-collection"></i> Разгледай ресурсите
            </a>
        }
    </div>
</div>
