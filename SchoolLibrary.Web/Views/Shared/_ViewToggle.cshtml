@* Cards or a list (sl-view-toggle.js). Hidden until the script shows it: without JavaScript it would do nothing *@
<div class="btn-group btn-group-sm view-toggle" role="group" aria-label="Изглед" data-view-toggle hidden>
    <button type="button" class="btn btn-outline-secondary active" data-view="cards" aria-pressed="true"
            data-sl-tip="Карти" data-sl-placement="top" aria-label="Карти"><i class="bi bi-grid-3x2-gap" aria-hidden="true"></i></button>
    <button type="button" class="btn btn-outline-secondary" data-view="list" aria-pressed="false"
            data-sl-tip="Списък" data-sl-placement="top" aria-label="Списък"><i class="bi bi-list-ul" aria-hidden="true"></i></button>
</div>
