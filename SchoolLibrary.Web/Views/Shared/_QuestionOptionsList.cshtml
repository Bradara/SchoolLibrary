@using SchoolLibrary.Data.Enums
@using SchoolLibrary.Services.Quizzes
@model SchoolLibrary.Data.Models.Question
@* The answer options of a question for the teacher, with the correct ones marked. A multiple-choice
   question also shows each option's share of the points; a short-answer question lists its accepted
   answers (and their share when it is not the full 100%). *@
@if (Model.Type == QuestionType.Numerical)
{
    <div class="small text-body-secondary">Приемливи числа:</div>
}
@if (Model.Type == QuestionType.ShortAnswer)
{
    <div class="small text-body-secondary">
        Приемливи отговори@(Model.CaseSensitive ? " (различават се малки и главни букви)" : ""):
    </div>
}
<ul class="list-unstyled mb-0">
    @foreach (var option in Model.Options.OrderBy(o => o.Order))
    {
        var credits = QuestionResult.Credits(option);
        <li class="@(credits ? "text-success fw-semibold" : "")">
            @if (credits)
            {
                <i class="bi bi-check-circle-fill"></i>
            }
            else
            {
                <i class="bi bi-circle"></i>
            }
            @if (Model.Type == QuestionType.Numerical)
            {
                @NumericAnswer.Display(option.Text)
                @if (option.Text != NumericAnswer.AnyNumber && option.Tolerance > 0)
                {
                    <span class="fw-normal"> ± @NumericAnswer.Display(option.Tolerance.Value)</span>
                }
            }
            else
            {
                @option.Text
            }
            @if (Model.Type == QuestionType.MultipleChoice
                 || (Model.Type is QuestionType.ShortAnswer or QuestionType.Numerical
                     && option.Fraction != SchoolLibrary.Data.Models.AnswerOption.FullCredit))
            {
                <span class="small text-body-secondary fw-normal">(@QuizPoints.Format(option.Fraction)%)</span>
            }
        </li>
    }
</ul>
