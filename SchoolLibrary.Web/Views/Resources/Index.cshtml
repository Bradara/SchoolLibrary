@model SchoolLibrary.ViewModels.ResourceIndexViewModel

@using SchoolLibrary.Data.Enums
@using SchoolLibrary.Services.Resources
@using SchoolLibrary.ViewModels
@{
    var (heading, newLabel) = Model.Kind switch
    {
        ResourceKind.External => ("🌐 Свободни ресурси", "+ Нов свободен ресурс"),
        ResourceKind.Lesson => ("🎓 Уроци", "+ Нов урок"),
        ResourceKind.Upload => ("📤 Качени материали", "+ Качи материал"),
        _ => ("📚 Учебни ресурси", "+ Нов ресурс")
    };
    ViewData["Title"] = heading[3..];
    var query = Model.Query;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    bool? FavoriteOf(int id) => User.Identity?.IsAuthenticated == true ? Model.FavoriteIds.Contains(id) : null;
    ResourceCardModel Card(SchoolLibrary.Data.Models.Resource item) =>
        new(item, FavoriteOf(item.Id), returnUrl, ShowKind: Model.Kind == null);

    // "Още филтри" stays open while one of its filters is chosen
    var moreFiltersOpen = !string.IsNullOrEmpty(Model.OwnerId) || Model.FromDate != null || Model.ToDate != null;

    var sortOptions = new (ResourceSortOrder Value, string Text)[]
    {
        (ResourceSortOrder.DateDesc, "Най-нови първо"),
        (ResourceSortOrder.DateAsc, "Най-стари първо"),
        (ResourceSortOrder.TitleAsc, "Заглавие (А → Я)"),
        (ResourceSortOrder.TitleDesc, "Заглавие (Я → А)"),
        (ResourceSortOrder.AuthorAsc, "Автор (А → Я)"),
        (ResourceSortOrder.AuthorDesc, "Автор (Я → А)"),
        (ResourceSortOrder.OwnerAsc, "Публикувал (А → Я)")
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="mb-0">@heading</h1>
    @if (User.CanAddResources())
    {
        @if (Model.Kind == ResourceKind.Upload)
        {
            <a asp-action="Upload" class="btn btn-primary">@newLabel</a>
        }
        else
        {
            <div class="d-flex flex-wrap gap-2">
                @if (Model.Kind == ResourceKind.External)
                {
                    <a asp-controller="Discovery" asp-action="Index" class="btn btn-outline-primary">
                        <i class="bi bi-search"></i> Намери ресурси в мрежата
                    </a>
                }
                <a asp-action="Create" asp-route-kind="@(Model.Kind ?? ResourceKind.Lesson)" class="btn btn-primary">@newLabel</a>
            </div>
        }
    }
</div>

<partial name="_KindSwitch" model="Model" />

<!-- Търсене и още филтри: изпращат се заедно, а избраните вид, предмет, клас и ред остават -->
<form method="get" asp-action="Index" class="my-3" role="search">
    @if (Model.Kind.HasValue)
    {
        <input type="hidden" name="kind" value="@Model.Kind" />
    }
    @if (Model.CategoryId.HasValue)
    {
        <input type="hidden" name="categoryId" value="@Model.CategoryId" />
    }
    @if (Model.GradeLevelId.HasValue)
    {
        <input type="hidden" name="gradeLevelId" value="@Model.GradeLevelId" />
    }
    @if (Model.SortOrder != ResourceSortOrder.DateDesc)
    {
        <input type="hidden" name="sortOrder" value="@Model.SortOrder" />
    }

    <div class="d-flex flex-wrap gap-2">
        <div class="search-box">
            <label class="visually-hidden" for="searchTitle">Търсене по заглавие или автор</label>
            <i class="bi bi-search" aria-hidden="true"></i>
            <input id="searchTitle" type="search" name="searchTitle" value="@Model.SearchTitle" class="form-control"
                   placeholder="Търсене по заглавие или автор" />
        </div>
        <button type="submit" class="btn btn-primary">Търси</button>
        <button type="button" class="btn btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#more-filters"
                aria-expanded="@(moreFiltersOpen ? "true" : "false")" aria-controls="more-filters">
            <i class="bi bi-sliders" aria-hidden="true"></i> Още филтри
        </button>
    </div>

    <div class="collapse @(moreFiltersOpen ? "show" : null)" id="more-filters">
        <div class="more-filters d-flex flex-wrap gap-2 align-items-end mt-2">
            <div class="filter-field">
                <label class="form-label small mb-1" for="ownerId">Публикувал</label>
                <select id="ownerId" name="ownerId" class="form-select">
                    <option value="">Всички</option>
                    @foreach (var o in Model.Owners)
                    {
                        <option value="@o.Value" selected="@(Model.OwnerId == o.Value)">@o.Text</option>
                    }
                </select>
            </div>
            <div class="filter-field filter-field-date">
                <label class="form-label small mb-1" for="fromDate">От дата</label>
                <input id="fromDate" type="date" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="filter-field filter-field-date">
                <label class="form-label small mb-1" for="toDate">До дата</label>
                <input id="toDate" type="date" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <button type="submit" class="btn btn-outline-primary">Приложи</button>
        </div>
    </div>
</form>

<div class="mb-3">
    <partial name="_GradeChips" model="Model" />
</div>

<div class="mb-3">
    <partial name="_ActiveFilters" model="Model" />
</div>

@if (query.ShowsTiles)
{
    <h2 class="section-title">Предмети</h2>
    <div class="mb-4">
        <partial name="_SubjectTiles" model="Model" />
    </div>

    @if (Model.Resources.Any())
    {
        <div class="d-flex align-items-center gap-2 mb-2">
            <h2 class="section-title mb-0 me-auto">Най-нови</h2>
            <a asp-action="Index" asp-all-route-data="(query with { All = true }).ToRouteValues()" class="small">
                Виж всички (@Model.TotalCount) <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </a>
            <partial name="_ViewToggle" />
        </div>
        <div class="card-grid" data-resource-list>
            @foreach (var item in Model.Resources)
            {
                <partial name="_ResourceCard" model="Card(item)" />
            }
        </div>
    }
}
else
{
    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
        <h2 class="section-title mb-0 me-auto">Намерени: @Model.TotalCount</h2>

        <!-- Сортиране: същите избори, друг ред -->
        <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">
            @foreach (var value in query.ToRouteValues().Where(v => v.Key != "sortOrder"))
            {
                <input type="hidden" name="@value.Key" value="@value.Value" />
            }
            <label class="small text-body-secondary text-nowrap" for="sortOrder">Подреди:</label>
            <select id="sortOrder" name="sortOrder" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
                @foreach (var option in sortOptions)
                {
                    <option value="@option.Value" selected="@(Model.SortOrder == option.Value)">@option.Text</option>
                }
            </select>
            <noscript><button type="submit" class="btn btn-sm btn-outline-secondary">Подреди</button></noscript>
        </form>
        <partial name="_ViewToggle" />
    </div>

    @if (!Model.Resources.Any())
    {
        <div class="alert alert-info text-center py-5">
            <p class="mb-0">Няма ресурси по избраните критерии.</p>
        </div>
    }
    else
    {
        <div class="card-grid mb-4" data-resource-list>
            @foreach (var item in Model.Resources)
            {
                <partial name="_ResourceCard" model="Card(item)" />
            }
        </div>

        <partial name="_Pager" model="Model" />
    }
}
