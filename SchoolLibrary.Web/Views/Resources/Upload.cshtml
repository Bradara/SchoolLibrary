@using SchoolLibrary.Data.Enums
@using SchoolLibrary.Services.Resources
@model SchoolLibrary.ViewModels.ResourceUploadViewModel

@{
    ViewData["Title"] = "Качи материал";
    var accept = string.Join(",", UploadConstraints.AllowedExtensions);
}

<h1>Качи материал</h1>

<h4>Качване на файл (PDF, EPUB или Markdown)</h4>
<hr />
<div class="row">
    <div class="col-lg-8">
        <form asp-action="Upload" enctype="multipart/form-data" data-epub-metadata
              data-pdfjs-base="@Url.Content("~/lib/pdfjs/")">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @* The same kind list as on the add resource form; a link kind opens that form. It has no name, so it
               is not sent with the upload *@
            <div class="form-group mb-3">
                <label for="ResourceKindChoice" class="control-label">Вид</label>
                <select id="ResourceKindChoice" class="form-select" data-navigate-select>
                    <option data-href="@Url.Action("Create", new { kind = ResourceKind.Lesson })">Урок — авторски материал</option>
                    <option data-href="@Url.Action("Create", new { kind = ResourceKind.External })">Свободен ресурс — материал от мрежата</option>
                    <option selected>Качен материал — файл (PDF, EPUB, Markdown)</option>
                </select>
            </div>

            <div class="form-group mb-3">
                <label asp-for="File" class="control-label"></label>
                <input asp-for="File" type="file" class="form-control" accept="@accept" />
                <span asp-validation-for="File" class="text-danger"></span>
                <div class="form-text">
                    Разрешени формати: PDF, EPUB, Markdown (.pdf, .epub, .md).
                    Максимален размер: @UploadConstraints.MaxFileSizeMegabytes МБ.
                    При EPUB и PDF заглавието и авторът се попълват от файла, а обложката е от книгата или първата страница.
                </div>
                <div class="form-text text-success" data-epub-metadata-note hidden aria-live="polite">
                    <i class="bi bi-check2-circle" aria-hidden="true"></i> Заглавието и авторът са взети от файла — проверете ги.
                </div>
                @* The first page of a PDF, drawn in the browser (sl-pdf-cover.js); the server checks the picture *@
                <input asp-for="Cover" type="file" class="d-none" accept="image/jpeg" tabindex="-1" aria-hidden="true" />
                <div class="d-flex align-items-center gap-2 mt-2" data-pdf-cover-preview hidden>
                    <img alt="" class="border rounded" style="height: 6rem; width: auto;" />
                    <span class="form-text mt-0">Обложка: първата страница на документа.</span>
                </div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" data-epub-field="title" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Author" class="control-label"></label>
                <input asp-for="Author" class="form-control" data-epub-field="author" />
                <span asp-validation-for="Author" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Source" class="control-label"></label>
                <input asp-for="Source" class="form-control" />
                <span asp-validation-for="Source" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="LicenseId" class="control-label"></label>
                <select asp-for="LicenseId" class="form-select"
                        asp-items="@(new SelectList(Model.AllLicenses, "Id", "Name", Model.LicenseId))">
                    <option value="">— изберете лиценз —</option>
                </select>
                <span asp-validation-for="LicenseId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">@Html.DisplayNameFor(m => m.Audience)</label>
                <partial name="_AudiencePicker" model="Model.Audience" />
            </div>

            @* Toggle buttons: a hidden checkbox (btn-check) posts the value, the label is the visible button *@
            <div class="form-group mb-3">
                <label class="control-label">@Html.DisplayNameFor(m => m.SelectedCategoryIds)</label>
                <div class="border rounded p-2 d-flex flex-wrap gap-2" style="max-height: 16rem; overflow-y: auto;">
                    @foreach (var c in Model.AllCategories)
                    {
                        <input class="btn-check" type="checkbox" name="SelectedCategoryIds" autocomplete="off"
                               value="@c.Id" id="category-@c.Id"
                               checked="@Model.SelectedCategoryIds.Contains(c.Id)" />
                        <label class="btn btn-sm btn-outline-primary" for="category-@c.Id">@c.Name</label>
                    }
                </div>
                <span asp-validation-for="SelectedCategoryIds" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">@Html.DisplayNameFor(m => m.SelectedGradeLevelIds)</label>
                <div class="border rounded p-2 d-flex flex-wrap gap-2">
                    @foreach (var g in Model.AllGradeLevels)
                    {
                        <input class="btn-check" type="checkbox" name="SelectedGradeLevelIds" autocomplete="off"
                               value="@g.Id" id="grade-@g.Id"
                               checked="@Model.SelectedGradeLevelIds.Contains(g.Id)" />
                        <label class="btn btn-sm btn-outline-primary" for="grade-@g.Id">@g.Name</label>
                    }
                </div>
                <span asp-validation-for="SelectedGradeLevelIds" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Качи" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Отказ</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/lib/jszip/jszip.min.js"></script>
    <script src="~/js/sl-epub-metadata.js" asp-append-version="true"></script>
    <script type="module" src="~/js/sl-pdf-cover.js" asp-append-version="true"></script>
}
