@model string
@* Read aloud in the EPUB and the PDF readers; the model is the prefix of the ids ("sl-epub-speech", "sl-pdf-speech").
   sl-speech.js shows it only when the browser can speak (speechSynthesis); the voices come from the browser
   and the system, so the text never leaves the browser. *@
<div class="btn-group d-none" role="group" aria-label="Четене на глас" id="@(Model)">
    <button type="button" class="btn btn-sm btn-outline-secondary" id="@(Model)-play" aria-pressed="false">
        <i class="bi bi-volume-up" aria-hidden="true"></i> <span>Чети на глас</span>
    </button>
    <button type="button" class="btn btn-sm btn-outline-secondary" id="@(Model)-stop" aria-label="Спри четенето" disabled>
        <i class="bi bi-stop-fill" aria-hidden="true"></i>
    </button>
    <div class="btn-group" role="group">
        <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" id="@(Model)-settings-btn"
                data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-label="Глас и скорост">
            <i class="bi bi-gear" aria-hidden="true"></i>
        </button>
        <div class="dropdown-menu dropdown-menu-end p-3 sl-epub-settings" aria-labelledby="@(Model)-settings-btn">
            <label class="form-label small mb-1" for="@(Model)-voice">Глас</label>
            <select class="form-select form-select-sm" id="@(Model)-voice">
                <option value="">Автоматично</option>
            </select>
            <div class="form-text mb-3" id="@(Model)-voice-hint" aria-live="polite"></div>
            <label class="form-label small mb-1" for="@(Model)-rate">Скорост</label>
            <select class="form-select form-select-sm" id="@(Model)-rate">
                <option value="0.75">0,75×</option>
                <option value="1" selected>1×</option>
                <option value="1.25">1,25×</option>
                <option value="1.5">1,5×</option>
                <option value="2">2×</option>
            </select>
        </div>
    </div>
</div>
<span class="small text-body-secondary d-none" id="@(Model)-status" aria-live="polite"></span>
