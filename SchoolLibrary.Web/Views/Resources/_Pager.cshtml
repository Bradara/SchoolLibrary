@* Page links that keep the current search, filters and sort order *@
@model SchoolLibrary.ViewModels.ResourceIndexViewModel

@if (Model.TotalPages > 1)
{
    // Show a window of up to 5 page numbers around the current page
    var first = Math.Max(1, Model.Page - 2);
    var last = Math.Min(Model.TotalPages, first + 4);
    first = Math.Max(1, last - 4);

    Dictionary<string, string?> RouteFor(int page) => new()
    {
        ["searchTitle"] = Model.SearchTitle,
        ["categoryId"] = Model.CategoryId?.ToString(),
        ["gradeLevelId"] = Model.GradeLevelId?.ToString(),
        ["ownerId"] = Model.OwnerId,
        ["fromDate"] = Model.FromDate?.ToString("yyyy-MM-dd"),
        ["toDate"] = Model.ToDate?.ToString("yyyy-MM-dd"),
        ["sortOrder"] = Model.SortOrder.ToString(),
        ["page"] = page.ToString()
    };

    <nav aria-label="Страници с ресурси">
        <ul class="pagination justify-content-center flex-wrap">
            <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-all-route-data="RouteFor(Model.Page - 1)" aria-label="Предишна">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>

            @if (first > 1)
            {
                <li class="page-item"><a class="page-link" asp-action="Index" asp-all-route-data="RouteFor(1)">1</a></li>
                @if (first > 2)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
            }

            @for (var p = first; p <= last; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")" @(p == Model.Page ? "aria-current=page" : "")>
                    <a class="page-link" asp-action="Index" asp-all-route-data="RouteFor(p)">@p</a>
                </li>
            }

            @if (last < Model.TotalPages)
            {
                @if (last < Model.TotalPages - 1)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
                <li class="page-item"><a class="page-link" asp-action="Index" asp-all-route-data="RouteFor(Model.TotalPages)">@Model.TotalPages</a></li>
            }

            <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-all-route-data="RouteFor(Model.Page + 1)" aria-label="Следваща">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}
