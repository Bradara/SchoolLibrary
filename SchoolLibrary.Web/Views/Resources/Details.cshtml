@using SchoolLibrary.Data.Enums
@using SchoolLibrary.Extensions
@using SchoolLibrary.ViewModels
@model ResourceDetailsViewModel

@{
    ViewData["Title"] = Model.Resource.Title;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index" asp-route-kind="@Model.Resource.Kind">@Model.Resource.Kind.SectionTitle()</a></li>
        <li class="breadcrumb-item active">@Model.Resource.Title</li>
    </ol>
</nav>

<partial name="_MessagePartial" />

<h1>@Model.Resource.Title</h1>

<div class="mb-3">
    <span class="badge text-bg-info">@Model.Resource.Kind.Label()</span>
    @foreach (var c in Model.Resource.Categories.OrderBy(c => c.Name))
    {
        <span class="badge bg-primary">@c.Name</span>
    }
    @foreach (var g in Model.Resource.GradeLevels.OrderBy(g => g.Number))
    {
        <span class="badge bg-secondary">@g.Name</span>
    }
</div>

@if (!string.IsNullOrEmpty(Model.Resource.Description))
{
    <p class="lead">@Model.Resource.Description</p>
}

@if (Model.Resource.Kind == ResourceKind.Upload && Model.Resource.File != null)
{
    var serveUrl = Url.Action("Download", new { id = Model.Resource.Id });

    if (Model.Resource.File.ContentType == "application/pdf")
    {
        <div class="sl-viewer mb-4">
            <div class="sl-viewer-bar">
                <button type="button" class="btn btn-sm btn-outline-secondary ms-auto sl-viewer-toggle"
                        aria-label="На цял екран" aria-pressed="false"><i class="bi bi-arrows-fullscreen"></i></button>
            </div>
            <div class="sl-viewer-body sl-embed" style="height: 80vh;">
                <iframe src="@serveUrl" title="@Model.Resource.Title" loading="lazy"
                        style="width: 100%; height: 100%; border: 0;"></iframe>
            </div>
        </div>
    }
    else if (Model.MarkdownHtml != null)
    {
        @* The HTML is rendered and sanitized on the server (Markdig + HtmlSanitizer) *@
        <div class="sl-viewer mb-3">
            <div class="sl-viewer-bar">
                <button type="button" class="btn btn-sm btn-outline-secondary ms-auto sl-viewer-toggle"
                        aria-label="На цял екран" aria-pressed="false"><i class="bi bi-arrows-fullscreen"></i></button>
            </div>
            <article class="sl-viewer-body sl-markdown border rounded p-3 p-md-4">
                @Html.Raw(Model.MarkdownHtml)
            </article>
        </div>
    }
    else if (Model.Resource.File.ContentType == "application/epub+zip")
    {
        @* epub.js reads the file (served by Download) in the browser and renders it here *@
        <div class="sl-viewer sl-epub-reader mb-3">
            <div class="sl-viewer-body d-flex flex-column" style="height: 75vh;">
                <div class="sl-epub-toolbar d-flex flex-wrap align-items-center gap-2 mb-2">
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                                id="sl-epub-toc-btn" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-list-ul"></i> Съдържание
                        </button>
                        <ul class="dropdown-menu sl-epub-toc" id="sl-epub-toc" aria-labelledby="sl-epub-toc-btn"></ul>
                    </div>
                    <div class="btn-group" role="group" aria-label="Размер на шрифта">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="sl-epub-font-dec" aria-label="По-дребен шрифт">A−</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="sl-epub-font-inc" aria-label="По-едър шрифт">A+</button>
                    </div>
                    <partial name="_EpubReaderSettings" />
                    <span class="small text-body-secondary" id="sl-epub-sync" aria-live="polite"></span>
                    <button type="button" class="btn btn-sm btn-outline-secondary ms-auto sl-viewer-toggle"
                            aria-label="На цял екран" aria-pressed="false"><i class="bi bi-arrows-fullscreen"></i></button>
                </div>

                <div class="sl-epub-stage position-relative flex-grow-1">
                    <button type="button" class="sl-epub-nav sl-epub-nav-prev" id="sl-epub-prev" aria-label="Предишна страница"><i class="bi bi-chevron-left"></i></button>
                    @* Signed in: the position is kept on the server (any device); a visitor keeps it in this browser *@
                    <div id="sl-epub" class="border rounded bg-body h-100"
                         data-epub-url="@serveUrl" data-epub-key="epub-pos-@Model.Resource.Id"
                         data-epub-save-url="@(User.Identity?.IsAuthenticated == true ? Url.Action("SaveReadingPosition", new { id = Model.Resource.Id }) : null)"
                         data-epub-position="@Model.ReadingPosition?.Cfi"
                         data-epub-percent="@Model.ReadingPosition?.Percent"></div>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form id="sl-epub-token" class="d-none">@Html.AntiForgeryToken()</form>
                    }
                    <button type="button" class="sl-epub-nav sl-epub-nav-next" id="sl-epub-next" aria-label="Следваща страница"><i class="bi bi-chevron-right"></i></button>
                </div>

                <div class="sl-epub-progress d-flex align-items-center gap-2 mt-2 small text-body-secondary">
                    <input type="range" class="form-range flex-grow-1" id="sl-epub-range"
                           min="0" max="100" value="0" step="1" aria-label="Позиция в книгата">
                    <span id="sl-epub-percent">0%</span>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info mb-3">Прегледът на този файл ще се покаже тук.</div>
    }

    <div class="mb-2">
        <a href="@Url.Action("Download", new { id = Model.Resource.Id, download = true })"
           class="btn btn-outline-secondary btn-sm">Свали файла ↓</a>
        <span class="text-body-secondary small ms-2">@Model.Resource.File.FileName</span>
    </div>
}
else if (Model.Resource.IsEmbeddable)
{
    <div class="sl-viewer mb-4">
        <div class="sl-viewer-bar">
            <button type="button" class="btn btn-sm btn-outline-secondary ms-auto sl-viewer-toggle"
                    aria-label="На цял екран" aria-pressed="false"><i class="bi bi-arrows-fullscreen"></i></button>
        </div>
        <div class="sl-viewer-body ratio ratio-16x9 sl-embed">
            <iframe src="@Model.Resource.EmbedUrl"
                    title="@Model.Resource.Title"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                    loading="lazy"
                    referrerpolicy="strict-origin-when-cross-origin">
            </iframe>
        </div>
    </div>

    <a href="@Model.Resource.SafeUrl" target="_blank" rel="noopener" class="btn btn-outline-secondary btn-sm">
        Отвори в нов таб ↗
    </a>
}
else if (Model.Resource.SafeUrl != null)
{
    <a href="@Model.Resource.SafeUrl" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
        Отвори ресурса ↗
    </a>
}
else
{
    <div class="alert alert-warning">Адресът на този ресурс не е валиден.</div>
}

<div class="mt-3 d-flex align-items-center gap-2">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <partial name="_FavoriteButton"
                 model="new FavoriteButtonModel(Model.Resource.Id, Model.IsFavorite, Context.Request.Path + Context.Request.QueryString)" />
        <a asp-controller="Reports" asp-action="Create" asp-route-resourceId="@Model.Resource.Id"
           class="btn btn-sm btn-outline-secondary"
           data-sl-tip="Подай сигнал" data-sl-placement="top" aria-label="Подай сигнал"><i class="bi bi-flag"></i></a>
    }
    <span class="text-body-secondary small">
        <i class="bi bi-heart-fill text-danger"></i>
        @Model.FavoriteCount @(Model.FavoriteCount == 1 ? "потребител е добавил" : "потребители са добавили") в любими
    </span>
</div>

<hr />

<div class="text-muted small">
    <div>Автор: <strong>@Model.Resource.Author</strong></div>
    <div>Източник: <strong>@Model.Resource.Source</strong></div>
    <div>
        Лиценз:
        @if (Model.Resource.License == null)
        {
            <strong>Не е посочен</strong>
        }
        else if (!string.IsNullOrEmpty(Model.Resource.License.Url))
        {
            <a href="@Model.Resource.License.Url" target="_blank" rel="noopener noreferrer"><strong>@Model.Resource.License.Name</strong></a>
        }
        else
        {
            <strong>@Model.Resource.License.Name</strong>
        }
    </div>
    <div>Публикувал: <strong>@Model.Resource.PublisherName()</strong></div>
    <div>Дата: @Model.Resource.CreatedOn.ToString("dd.MM.yyyy HH:mm")</div>
</div>

@{
    var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var isAdministrator = User.IsInRole(SchoolLibrary.Data.Constants.Roles.Administrator);
}
@if (User.Identity?.IsAuthenticated == true && SchoolLibrary.Services.Resources.ResourcePermissions.CanEdit(Model.Resource, userId, isAdministrator))
{
    <div class="mt-4">
        @if (Model.Resource.Kind != ResourceKind.Upload)
        {
            <a asp-action="Edit" asp-route-id="@Model.Resource.Id" class="btn btn-outline-primary">Редактирай</a>
        }
        <a asp-action="Delete" asp-route-id="@Model.Resource.Id" class="btn btn-outline-danger">Изтрий</a>
    </div>
}

<partial name="_Comments" model="Model" />

<div class="mt-3">
    <a asp-action="Index" class="btn btn-link">← Към списъка</a>
</div>

@section Scripts {
    @if ((Model.Resource.Kind == ResourceKind.Upload && Model.Resource.File != null) || Model.Resource.IsEmbeddable)
    {
        <script src="~/js/sl-maximize.js" asp-append-version="true"></script>
    }
    @if (Model.Resource.Kind == ResourceKind.Upload && Model.Resource.File?.ContentType == "application/epub+zip")
    {
        <script src="~/lib/jszip/jszip.min.js"></script>
        <script src="~/lib/epubjs/epub.min.js"></script>
        <script src="~/js/sl-epub-reader.js" asp-append-version="true"></script>
    }
}