@model SchoolLibrary.Data.Models.Resource

@{
    ViewData["Title"] = Model.Title;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index" asp-route-kind="@Model.Kind">@(Model.Kind == SchoolLibrary.Data.Enums.ResourceKind.External ? "Свободни ресурси" : "Уроци")</a></li>
        <li class="breadcrumb-item active">@Model.Title</li>
    </ol>
</nav>

<h1>@Model.Title</h1>

<div class="mb-3">
    <span class="badge text-bg-info">@(Model.Kind == SchoolLibrary.Data.Enums.ResourceKind.External ? "Свободен ресурс" : "Урок")</span>
    @foreach (var c in Model.Categories.OrderBy(c => c.Name))
    {
        <span class="badge bg-primary">@c.Name</span>
    }
    @foreach (var g in Model.GradeLevels.OrderBy(g => g.Number))
    {
        <span class="badge bg-secondary">@g.Name</span>
    }
</div>

@if (!string.IsNullOrEmpty(Model.Description))
{
    <p class="lead">@Model.Description</p>
}

@if (Model.IsEmbeddable)
{
    <div class="ratio ratio-16x9 mb-4 sl-embed">
        <iframe src="@Model.EmbedUrl"
                title="@Model.Title"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
                referrerpolicy="strict-origin-when-cross-origin">
        </iframe>
    </div>

    <a href="@Model.Url" target="_blank" rel="noopener" class="btn btn-outline-secondary btn-sm">
        Отвори в нов таб ↗
    </a>
}
else
{
    <a href="@Model.Url" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
        Отвори ресурса ↗
    </a>
}

<hr />

<div class="text-muted small">
    <div>Автор: <strong>@Model.Author</strong></div>
    <div>Източник: <strong>@Model.Source</strong></div>
    <div>
        Лиценз:
        @if (Model.License == null)
        {
            <strong>Не е посочен</strong>
        }
        else if (!string.IsNullOrEmpty(Model.License.Url))
        {
            <a href="@Model.License.Url" target="_blank" rel="noopener noreferrer"><strong>@Model.License.Name</strong></a>
        }
        else
        {
            <strong>@Model.License.Name</strong>
        }
    </div>
    <div>Публикувал: <strong>@Model.PublisherName()</strong></div>
    <div>Дата: @Model.CreatedOn.ToString("dd.MM.yyyy HH:mm")</div>
</div>

@{
    var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var isAdministrator = User.IsInRole(SchoolLibrary.Data.Constants.Roles.Administrator);
}
@if (User.Identity?.IsAuthenticated == true && SchoolLibrary.Services.Resources.ResourcePermissions.CanEdit(Model, userId, isAdministrator))
{
    <div class="mt-4">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Редактирай</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Изтрий</a>
    </div>
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-link">← Към списъка</a>
</div>