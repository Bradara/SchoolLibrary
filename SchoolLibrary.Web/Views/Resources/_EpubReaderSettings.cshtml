@* Text settings of the EPUB reader. sl-epub-reader.js applies them and keeps them in this browser. *@
<div class="dropdown">
    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" id="sl-epub-settings-btn"
            data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
        <i class="bi bi-sliders"></i> Текст
    </button>
    <div class="dropdown-menu p-3 sl-epub-settings" aria-labelledby="sl-epub-settings-btn">
        <div class="form-check form-switch mb-2">
            <input class="form-check-input" type="checkbox" role="switch" id="sl-epub-justify">
            <label class="form-check-label" for="sl-epub-justify">Двустранно подравняване</label>
        </div>
        <div class="form-check form-switch mb-2">
            <input class="form-check-input" type="checkbox" role="switch" id="sl-epub-hyphens">
            <label class="form-check-label" for="sl-epub-hyphens">Пренасяне на думите</label>
        </div>
        <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" role="switch" id="sl-epub-spread">
            <label class="form-check-label" for="sl-epub-spread">Две страници на широк екран</label>
        </div>

        <label class="form-label small mb-1" for="sl-epub-family">Шрифт</label>
        <select class="form-select form-select-sm mb-2" id="sl-epub-family">
            <option value="">Като в книгата</option>
            <option value="serif">Със засечки</option>
            <option value="sans">Без засечки</option>
            <option value="wide">Широк (по-лесен за четене)</option>
        </select>

        <label class="form-label small mb-1" for="sl-epub-line">Междуредие</label>
        <select class="form-select form-select-sm mb-3" id="sl-epub-line">
            <option value="">Като в книгата</option>
            <option value="1.3">Плътно</option>
            <option value="1.6">Нормално</option>
            <option value="2">Широко</option>
        </select>

        <button type="button" class="btn btn-sm btn-link p-0" id="sl-epub-settings-reset">Връщане по подразбиране</button>
        <p class="small text-body-secondary mt-2 mb-0">
            Настройките се пазят в този браузър. Пренасянето зависи от браузъра.
        </p>
    </div>
</div>
