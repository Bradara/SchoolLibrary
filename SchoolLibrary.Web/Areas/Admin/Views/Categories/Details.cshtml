@model SchoolLibrary.Data.Models.Category

@{
    ViewData["Title"] = "Детайли на предмет";
}

<h1>@Model.Name</h1>

<div class="mb-3">
    <a asp-action="Index" class="btn btn-secondary">Обратно към списъка</a>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Редактирай</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Изтрий</a>
    }
</div>

<h4>Ресурси в този предмет</h4>
@if (Model.Resources == null || !Model.Resources.Any())
{
    <div class="alert alert-info">Няма ресурси в този предмет.</div>
}
else
{
    <ul class="list-group">
        @foreach (var res in Model.Resources)
        {
            <li class="list-group-item">
                <a asp-area="" asp-controller="Resources" asp-action="Details" asp-route-id="@res.Id">@res.Title</a>
            </li>
        }
    </ul>
}
