@model SchoolLibrary.Areas.Admin.Models.CategoryFormViewModel

@{
    ViewData["Title"] = "Редактирай предмет";
}

<h1>Редактирай предмет</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <partial name="_CategoryForm" model="Model" />
    <button type="submit" class="btn btn-primary">Запази</button>
    <a asp-action="Index" class="btn btn-secondary">Отказ</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/sl-subject-picker.js" asp-append-version="true"></script>
}
