@model SchoolLibrary.Areas.Admin.Models.CategoryFormViewModel

@{
    ViewData["Title"] = "Създай предмет";
}

<h1>Нов предмет</h1>

<form asp-action="Create" method="post">
    <partial name="_CategoryForm" model="Model" />
    <button type="submit" class="btn btn-primary">Създай</button>
    <a asp-action="Index" class="btn btn-secondary">Отказ</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/sl-subject-picker.js" asp-append-version="true"></script>
}
