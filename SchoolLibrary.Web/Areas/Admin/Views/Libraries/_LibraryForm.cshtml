@model SchoolLibrary.Areas.Admin.Models.OnlineLibraryFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<input type="hidden" asp-for="Id" />
<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Url" class="form-label"></label>
    <input asp-for="Url" class="form-control" placeholder="https://" />
    <span asp-validation-for="Url" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>
<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Icon" class="form-label"></label>
        <select asp-for="Icon" class="form-select" asp-items="@((IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Icons)"></select>
        <span asp-validation-for="Icon" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="SortOrder" class="form-label"></label>
        <input asp-for="SortOrder" class="form-control" type="number" min="0" max="10000" />
        <span asp-validation-for="SortOrder" class="text-danger"></span>
    </div>
</div>
