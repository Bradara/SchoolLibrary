@model SchoolLibrary.Areas.Admin.Models.OnlineLibraryFormViewModel

@{
    ViewData["Title"] = "Нова библиотека";
}

<h1>Нова библиотека</h1>

<form asp-action="Create" method="post">
    <partial name="_LibraryForm" model="Model" />
    <button type="submit" class="btn btn-primary">Създай</button>
    <a asp-action="Index" class="btn btn-secondary">Отказ</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
