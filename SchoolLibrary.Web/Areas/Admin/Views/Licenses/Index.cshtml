@model IEnumerable<SchoolLibrary.Services.Licenses.LicenseListItem>

@{
    ViewData["Title"] = "Лицензи";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Лицензи</h1>
    <a asp-action="Create" class="btn btn-primary">+ Нов лиценз</a>
</div>

<partial name="_MessagePartial" />

@if (!Model.Any())
{
    <div class="alert alert-info text-center py-5">Все още няма лицензи.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Име</th>
                    <th>Описание</th>
                    <th>Брой ресурси</th>
                    <th class="text-end">Операции</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">
                            @item.License.Name
                            @if (!string.IsNullOrEmpty(item.License.Url))
                            {
                                <a href="@item.License.Url" target="_blank" rel="noopener noreferrer" class="ms-1 text-decoration-none"
                                   data-sl-tip="Текст на лиценза" data-sl-placement="top" aria-label="Текст на лиценза"><i class="bi bi-box-arrow-up-right"></i></a>
                            }
                        </td>
                        <td class="text-muted">@item.License.Description</td>
                        <td>@item.ResourceCount</td>
                        <td class="text-end text-nowrap">
                            <div class="d-inline-flex gap-1">
                                <a asp-action="Edit" asp-route-id="@item.License.Id" class="btn btn-sm btn-outline-primary"
                                   data-sl-tip="Редактирай" data-sl-placement="top" aria-label="Редактирай"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.License.Id" class="btn btn-sm btn-outline-danger"
                                   data-sl-tip="Изтрий" data-sl-placement="top" aria-label="Изтрий"><i class="bi bi-trash"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
