@model SchoolLibrary.Areas.Admin.Models.LicenseFormViewModel

@{
    ViewData["Title"] = "Нов лиценз";
}

<h1>Нов лиценз</h1>

<form asp-action="Create" method="post">
    <partial name="_LicenseForm" model="Model" />
    <button type="submit" class="btn btn-primary">Създай</button>
    <a asp-action="Index" class="btn btn-secondary">Отказ</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
