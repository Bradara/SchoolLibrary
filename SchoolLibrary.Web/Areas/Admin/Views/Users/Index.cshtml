@model SchoolLibrary.Areas.Admin.Models.UserIndexViewModel

@{
    ViewData["Title"] = "Потребители";

    string RoleLabel(string role) => role switch
    {
        Roles.Administrator => "Администратор",
        Roles.Teacher => "Учител",
        Roles.Student => "Ученик",
        Roles.Parent => "Родител",
        _ => role
    };

    Dictionary<string, string?> RouteFor(int page) => new()
    {
        ["search"] = Model.Search,
        ["pending"] = Model.Pending ? "true" : null,
        ["page"] = page.ToString()
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Потребители <small class="text-muted fs-6">(@Model.TotalCount)</small></h1>
</div>

<partial name="_MessagePartial" />

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-12 col-md">
        <label for="search" class="form-label">Търсене по име или имейл</label>
        <input id="search" name="search" value="@Model.Search" class="form-control" maxlength="100" />
    </div>
    <div class="col-auto">
        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" id="pending" name="pending" value="true" @(Model.Pending ? "checked" : "") />
            <label class="form-check-label" for="pending">Само чакащи учители</label>
        </div>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Търси</button>
    </div>
</form>

@if (!Model.Users.Any())
{
    <div class="alert alert-info text-center py-5">Няма намерени потребители.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Име</th>
                    <th>Имейл</th>
                    <th>Роли</th>
                    <th>Регистриран</th>
                    <th class="text-end">Операции</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    var isAdmin = user.Roles.Contains(Roles.Administrator);
                    <tr>
                        <td class="fw-bold">@user.FullName</td>
                        <td>@user.Email</td>
                        <td>
                            @foreach (var role in user.Roles.Where(r => r != Roles.User))
                            {
                                <span class="badge text-bg-secondary">@RoleLabel(role)</span>
                            }
                            @if (user.TeacherRequested)
                            {
                                <span class="badge text-bg-warning">Чака потвърждение</span>
                            }
                        </td>
                        <td>@user.CreatedOn.ToLocalTime().ToString("dd.MM.yyyy")</td>
                        <td class="text-end text-nowrap">
                            <div class="d-inline-flex gap-1">
                                @if (user.TeacherRequested)
                                {
                                    <form asp-action="ApproveTeacher" asp-route-id="@user.Id" method="post">
                                        <button type="submit" class="btn btn-sm btn-outline-success"
                                                data-sl-tip="Одобри учител" data-sl-placement="top" aria-label="Одобри учител"><i class="bi bi-check-lg"></i></button>
                                    </form>
                                    <form asp-action="RejectTeacher" asp-route-id="@user.Id" method="post">
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                data-sl-tip="Отхвърли заявката" data-sl-placement="top" aria-label="Отхвърли заявката"><i class="bi bi-x-lg"></i></button>
                                    </form>
                                }
                                @if (isAdmin && user.Id != Model.CurrentUserId)
                                {
                                    <form asp-action="SetAdministrator" asp-route-id="@user.Id" asp-route-makeAdministrator="false" method="post">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary"
                                                data-sl-tip="Премахни администратор" data-sl-placement="top" aria-label="Премахни администратор"><i class="bi bi-shield-minus"></i></button>
                                    </form>
                                }
                                else if (!isAdmin)
                                {
                                    <form asp-action="SetAdministrator" asp-route-id="@user.Id" asp-route-makeAdministrator="true" method="post">
                                        <button type="submit" class="btn btn-sm btn-outline-primary"
                                                data-sl-tip="Направи администратор" data-sl-placement="top" aria-label="Направи администратор"><i class="bi bi-shield-plus"></i></button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Страници с потребители">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-all-route-data="RouteFor(Model.Page - 1)" aria-label="Предишна"><i class="bi bi-chevron-left"></i></a>
                </li>
                <li class="page-item disabled"><span class="page-link">@Model.Page / @Model.TotalPages</span></li>
                <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-all-route-data="RouteFor(Model.Page + 1)" aria-label="Следваща"><i class="bi bi-chevron-right"></i></a>
                </li>
            </ul>
        </nav>
    }
}
