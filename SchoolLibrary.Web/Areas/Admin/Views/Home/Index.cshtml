@model SchoolLibrary.Services.Statistics.DashboardStatistics

@{
    ViewData["Title"] = "Администрация";
}

<h1 class="mb-4">Администрация</h1>

<partial name="_MessagePartial" />

<div class="row g-3">
    <div class="col-6 col-lg">
        <div class="card h-100 text-center">
            <div class="card-body">
                <i class="bi bi-people fs-2"></i>
                <div class="fs-3 fw-bold">@Model.Users</div>
                <div class="text-muted">Потребители</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg">
        <div class="card h-100 text-center">
            <div class="card-body">
                <i class="bi bi-collection fs-2"></i>
                <div class="fs-3 fw-bold">@Model.Resources</div>
                <div class="text-muted">Ресурси</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg">
        <div class="card h-100 text-center">
            <div class="card-body">
                <i class="bi bi-tags fs-2"></i>
                <div class="fs-3 fw-bold">@Model.Categories</div>
                <div class="text-muted">Предмети</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg">
        <div class="card h-100 text-center @(Model.PendingTeachers > 0 ? "border-warning" : "")">
            <div class="card-body">
                <i class="bi bi-person-check fs-2"></i>
                <div class="fs-3 fw-bold">@Model.PendingTeachers</div>
                <div class="text-muted">Чакащи учители</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg">
        <div class="card h-100 text-center @(Model.NewReports > 0 ? "border-danger" : "")">
            <div class="card-body">
                <i class="bi bi-flag fs-2"></i>
                <div class="fs-3 fw-bold">@Model.NewReports</div>
                <div class="text-muted">Нови сигнали</div>
            </div>
        </div>
    </div>
</div>

<div class="mt-4 d-flex flex-wrap gap-2">
    <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="btn btn-outline-primary">
        <i class="bi bi-tags"></i> Управление на предмети
    </a>
    <a asp-area="Admin" asp-controller="GradeLevels" asp-action="Index" class="btn btn-outline-primary">
        <i class="bi bi-mortarboard"></i> Класове
    </a>
    <a asp-area="Admin" asp-controller="Licenses" asp-action="Index" class="btn btn-outline-primary">
        <i class="bi bi-patch-check"></i> Управление на лицензи
    </a>
    <a asp-area="Admin" asp-controller="Libraries" asp-action="Index" class="btn btn-outline-primary">
        <i class="bi bi-bookshelf"></i> Онлайн библиотеки
    </a>
    <a asp-area="Admin" asp-controller="ResourceImport" asp-action="Index" class="btn btn-outline-primary">
        <i class="bi bi-file-earmark-arrow-up"></i> Импорт на ресурси
    </a>
    <a asp-area="Admin" asp-controller="Reports" asp-action="Index" class="btn @(Model.NewReports > 0 ? "btn-danger" : "btn-outline-primary")">
        <i class="bi bi-flag"></i> Сигнали@(Model.NewReports > 0 ? $" ({Model.NewReports})" : "")
    </a>
    <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn btn-outline-primary">
        <i class="bi bi-people"></i> Потребители
    </a>
    @if (Model.PendingTeachers > 0)
    {
        <a asp-area="Admin" asp-controller="Users" asp-action="Index" asp-route-pending="true" class="btn btn-warning">
            <i class="bi bi-person-check"></i> Чакащи учители (@Model.PendingTeachers)
        </a>
    }
</div>

@if (ViewData["BooksWithoutCover"] is int booksWithoutCover && booksWithoutCover > 0)
{
    @* Books uploaded before covers were kept, or books with no cover picture inside *@
    <div class="card mt-4">
        <div class="card-body d-flex flex-wrap align-items-center gap-3">
            <i class="bi bi-book fs-3" aria-hidden="true"></i>
            <div class="me-auto">
                <div class="fw-semibold">Книги без обложка: @booksWithoutCover</div>
                <div class="text-muted small">Обложката се взима от самия EPUB файл. Книга без обложка във файла остава с цветната лента.</div>
            </div>
            <form asp-area="Admin" asp-controller="BookCovers" asp-action="Extract" method="post">
                <button type="submit" class="btn btn-outline-primary">
                    <i class="bi bi-image" aria-hidden="true"></i> Извлечи обложките
                </button>
            </form>
        </div>
    </div>
}

@if (ViewData["PdfsWithoutCover"] is int pdfsWithoutCover && pdfsWithoutCover > 0)
{
    @* PDF files uploaded before covers were kept: the cover is their first page, drawn in this browser *@
    <div class="card mt-4">
        <div class="card-body d-flex flex-wrap align-items-center gap-3">
            <i class="bi bi-file-earmark-pdf fs-3" aria-hidden="true"></i>
            <div class="me-auto">
                <div class="fw-semibold">PDF файлове без обложка: @pdfsWithoutCover</div>
                <div class="text-muted small">Обложката е първата страница на документа. Рисува се в този браузър и се изпраща на сървъра.</div>
            </div>
            <a asp-area="Admin" asp-controller="BookCovers" asp-action="Pdfs" class="btn btn-outline-primary">
                <i class="bi bi-image" aria-hidden="true"></i> Направи обложките
            </a>
        </div>
    </div>
}
