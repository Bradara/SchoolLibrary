@page
@model SchoolLibrary.Areas.Identity.Pages.Account.RegisterModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Регистрация";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-9 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-md-5">

                <div class="text-center mb-4">
                    <div class="display-5 mb-2">📚</div>
                    <h1 class="h3 mb-1">Регистрация</h1>
                    <p class="text-muted mb-0">Създайте профил, за да добавяте учебни ресурси</p>
                </div>

                <form id="registerForm" method="post" asp-route-returnUrl="@Model.ReturnUrl">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="Input.FirstName" class="form-label">Име</label>
                            <input asp-for="Input.FirstName" class="form-control" autocomplete="given-name" />
                            <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Input.LastName" class="form-label">Фамилия</label>
                            <input asp-for="Input.LastName" class="form-control" autocomplete="family-name" />
                            <span asp-validation-for="Input.LastName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">Имейл</label>
                        <input asp-for="Input.Email" type="email" class="form-control"
                               autocomplete="username" placeholder="name@example.com" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label">Парола</label>
                        <div class="input-group">
                            <input asp-for="Input.Password" type="password" class="form-control"
                                   autocomplete="new-password" aria-describedby="passwordHelp" />
                            <button type="button" class="btn btn-outline-secondary js-toggle-password"
                                    aria-label="Покажи паролата">👁</button>
                        </div>
                        <div id="passwordHelp" class="form-text">
                            Поне 6 знака, с главна и малка буква, цифра и специален символ.
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.ConfirmPassword" class="form-label">Повторете паролата</label>
                        <div class="input-group">
                            <input asp-for="Input.ConfirmPassword" type="password" class="form-control"
                                   autocomplete="new-password" />
                            <button type="button" class="btn btn-outline-secondary js-toggle-password"
                                    aria-label="Покажи паролата">👁</button>
                        </div>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button id="registerSubmit" type="submit" class="btn btn-primary w-100 py-2">Създай профил</button>
                </form>

                <hr class="my-4" />

                <p class="text-center mb-0">
                    Вече имате профил?
                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Влезте</a>
                </p>

                <p class="text-center text-muted small mt-3 mb-0">
                    С регистрацията приемате
                    <a asp-area="" asp-controller="Home" asp-action="About" asp-fragment="copyright">правилата за споделяне и авторско право</a>.
                </p>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.js-toggle-password').forEach(function (button) {
            button.addEventListener('click', function () {
                var input = button.parentElement.querySelector('input');
                var isHidden = input.type === 'password';
                input.type = isHidden ? 'text' : 'password';
                button.textContent = isHidden ? '🙈' : '👁';
                button.setAttribute('aria-label', isHidden ? 'Скрий паролата' : 'Покажи паролата');
            });
        });
    </script>
}

