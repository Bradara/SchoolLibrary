@model ErrorViewModel
@{
    ViewData["Title"] = "Грешка";
}

<div class="text-center py-5">
    <div class="fs-1">😔</div>
    <h1 class="mt-3">Нещо се обърка</h1>
    <p class="lead">Съжаляваме, но не успяхме да обработим Вашата заявка.</p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">
            Request ID: <code>@Model.RequestId</code>
        </p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">
        Върни се в началото
    </a>
</div>