@using Microsoft.AspNetCore.Identity
@using SchoolLibrary.Data.Models
@inject SignInManager<ApplicationUser> SignInManager

<ul class="nav flex-column gap-1">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a class="nav-link text-truncate" asp-area="Identity" asp-page="/Account/Manage/Index" title="Моят профил">
            <i class="bi bi-person-circle"></i> @User.Identity?.Name
        </a>
    </li>
    <li class="nav-item">
        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="nav-link btn btn-link w-100 text-start">
                <i class="bi bi-box-arrow-right"></i> Изход
            </button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Register"><i class="bi bi-person-plus"></i> Регистрация</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Login"><i class="bi bi-box-arrow-in-right"></i> Вход</a>
    </li>
}
</ul>
