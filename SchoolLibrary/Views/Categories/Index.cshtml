@model IEnumerable<SchoolLibrary.Data.Models.Category>

@{
    ViewData["Title"] = "Предмети";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Предмети</h1>

    <partial name="_MessagePartial" />   

    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-action="Create" class="btn btn-primary">+ Нов предмет</a>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center py-5">Все още няма предмети.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Име</th>
                    <th>Брой ресурси</th>
                    <th class="text-end">Операции</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="fw-bold text-decoration-none">@item.Name</a>
                        </td>
                        <td>
                            @(item.Resources?.Count ?? 0)
                        </td>
                        <td class="text-end text-nowrap">
                            <div class="d-inline-flex gap-1">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary"
                                   data-sl-tip="Детайли" data-sl-placement="top" aria-label="Детайли"><i class="bi bi-eye"></i></a>
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary"
                                       data-sl-tip="Редактирай" data-sl-placement="top" aria-label="Редактирай"><i class="bi bi-pencil"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"
                                       data-sl-tip="Изтрий" data-sl-placement="top" aria-label="Изтрий"><i class="bi bi-trash"></i></a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
