@model SchoolLibrary.Data.Models.Resource

@{
    ViewData["Title"] = Model.Title;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Ресурси</a></li>
        <li class="breadcrumb-item active">@Model.Title</li>
    </ol>
</nav>

<h1>@Model.Title</h1>

<div class="mb-3">
    <span class="badge bg-primary">@Model.Category.Name</span>
    <span class="badge bg-secondary">@Model.GradeLevel.Name</span>
</div>

@if (!string.IsNullOrEmpty(Model.Description))
{
    <p class="lead">@Model.Description</p>
}

<div class="mb-4">
    <a href="@Model.Url" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
        Отвори ресурса ↗
    </a>
</div>

<hr />

<div class="text-muted small">
    <div>Публикувал: <strong>@Model.Owner.Email</strong></div>
    <div>Дата: @Model.CreatedOn.ToString("dd.MM.yyyy HH:mm")</div>
</div>

@if (User.Identity?.IsAuthenticated == true && Model.OwnerId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value)
{
    <div class="mt-4">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Редактирай</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Изтрий</a>
    </div>
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-link">← Към списъка</a>
</div>