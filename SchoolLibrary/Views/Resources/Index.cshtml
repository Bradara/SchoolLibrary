@model SchoolLibrary.ViewModels.ResourceIndexViewModel

@{
    ViewData["Title"] = "Ресурси";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>📚 Учебни ресурси</h1>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-action="Create" class="btn btn-primary">+ Нов ресурс</a>
    }
</div>

<!-- Филтри -->
<form method="get" class="card card-body bg-light mb-4">
    <div class="row g-2">
        <div class="col-md-3">
            <label class="form-label small">Търсене по заглавие</label>
            <input name="searchTitle" value="@Model.SearchTitle" class="form-control"
                   placeholder="Напиши ключова дума..." />
        </div>
        <div class="col-md-2">
            <label class="form-label small">Категория</label>
            <select name="categoryId" class="form-select">
                <option value="">Всички</option>
                @foreach (var c in Model.Categories)
                {
                    <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small">Клас</label>
            <select name="gradeLevelId" class="form-select">
                <option value="">Всички</option>
                @foreach (var g in Model.GradeLevels)
                {
                    <option value="@g.Id" selected="@(Model.GradeLevelId == g.Id)">@g.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small">Публикуващ</label>
            <select name="ownerId" class="form-select">
                <option value="">Всички</option>
                @foreach (var o in Model.Owners)
                {
                    <option value="@o.Value" selected="@(Model.OwnerId == o.Value)">@o.Text</option>
                }
            </select>
        </div>
        <div class="col-md-1">
            <label class="form-label small">От дата</label>
            <input type="date" name="fromDate"
                   value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div class="col-md-1">
            <label class="form-label small">До дата</label>
            <input type="date" name="toDate"
                   value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div class="col-md-1 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-150">🔍 </button>
        </div>
    </div>
    <div class="mt-2">
        <a asp-action="Index" class="btn btn-sm btn-link">Изчисти филтрите</a>
        <span class="text-muted small ms-3">Намерени: @Model.Resources.Count</span>
    </div>
</form>

<!-- Резултатите -->
@if (!Model.Resources.Any())
{
    <div class="alert alert-info text-center py-5">
        <p class="mb-0">Няма ресурси по избраните критерии.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Заглавие</th>
                    <th>Категория</th>
                    <th>Клас</th>
                    <th>Публикувал</th>
                    <th>Дата</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Resources)
                {
                    <tr>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="fw-bold text-decoration-none">
                                @item.Title
                            </a>
                        </td>
                        <td><span class="badge bg-primary text-primary-emphasis">@item.Category.Name</span></td>
                        <td><span class="badge bg-secondary text-secondary-emphasis">@item.GradeLevel.Name</span></td>
                        <td class="small text-dark">@item.Owner.Email</td>
                        <td class="small text-info">@item.CreatedOn.ToString("dd.MM.yyyy")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Детайли</a>
                            @if (User.Identity?.IsAuthenticated == true && item.OwnerId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value)
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Редактирай</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Изтрий</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}