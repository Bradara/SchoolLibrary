@model SchoolLibrary.ViewModels.ResourceIndexViewModel

@{
    ViewData["Title"] = "Ресурси";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>📚 Учебни ресурси <small class="fs-6 text-body-secondary">(намерени: @Model.Resources.Count)</small></h1>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-action="Create" class="btn btn-primary">+ Нов ресурс</a>
    }
</div>

<!-- Филтри и сортиране -->
<form method="get" class="card card-body bg-body-tertiary py-2 mb-4">
    <div class="d-flex flex-wrap gap-2 align-items-end">
        <div class="filter-field filter-field-wide">
            <label class="form-label small mb-1" for="searchTitle">Търсене</label>
            <input id="searchTitle" name="searchTitle" value="@Model.SearchTitle" class="form-control"
                   placeholder="Заглавие или автор..." />
        </div>
        <div class="filter-field">
            <label class="form-label small mb-1" for="categoryId">Предмет</label>
            <select id="categoryId" name="categoryId" class="form-select">
                <option value="">Всички</option>
                @foreach (var c in Model.Categories)
                {
                    <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option>
                }
            </select>
        </div>
        <div class="filter-field">
            <label class="form-label small mb-1" for="gradeLevelId">Клас</label>
            <select id="gradeLevelId" name="gradeLevelId" class="form-select">
                <option value="">Всички</option>
                @foreach (var g in Model.GradeLevels)
                {
                    <option value="@g.Id" selected="@(Model.GradeLevelId == g.Id)">@g.Name</option>
                }
            </select>
        </div>
        <div class="filter-field">
            <label class="form-label small mb-1" for="ownerId">Публикуващ</label>
            <select id="ownerId" name="ownerId" class="form-select">
                <option value="">Всички</option>
                @foreach (var o in Model.Owners)
                {
                    <option value="@o.Value" selected="@(Model.OwnerId == o.Value)">@o.Text</option>
                }
            </select>
        </div>
        <div class="filter-field filter-field-date">
            <label class="form-label small mb-1" for="fromDate">От дата</label>
            <input id="fromDate" type="date" name="fromDate"
                   value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div class="filter-field filter-field-date">
            <label class="form-label small mb-1" for="toDate">До дата</label>
            <input id="toDate" type="date" name="toDate"
                   value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div class="filter-field">
            <label class="form-label small mb-1" for="sortOrder">Сортиране</label>
            <select id="sortOrder" name="sortOrder" class="form-select" onchange="this.form.submit()">
                @{
                    var sortOptions = new (string Value, string Text)[]
                    {
                        ("", "Най-нови първо"),
                        ("date_asc", "Най-стари първо"),
                        ("title_asc", "Заглавие (А → Я)"),
                        ("title_desc", "Заглавие (Я → А)"),
                        ("author_asc", "Автор (А → Я)"),
                        ("author_desc", "Автор (Я → А)"),
                        ("owner_asc", "Публикувал (А → Я)")
                    };
                }
                @foreach (var opt in sortOptions)
                {
                    <option value="@opt.Value" selected="@((Model.SortOrder ?? "") == opt.Value)">@opt.Text</option>
                }
            </select>
        </div>
        <div class="d-flex gap-1">
            <button type="submit" class="btn btn-primary" title="Търси" aria-label="Търси"><i class="bi bi-search"></i></button>
            <a asp-action="Index" class="btn btn-outline-secondary" title="Изчисти филтрите" aria-label="Изчисти филтрите"><i class="bi bi-x-lg"></i></a>
        </div>
    </div>
</form>

<!-- Резултатите -->
@if (!Model.Resources.Any())
{
    <div class="alert alert-info text-center py-5">
        <p class="mb-0">Няма ресурси по избраните критерии.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Заглавие</th>
                    <th>Предмети</th>
                    <th>Класове</th>
                    <th>Публикувал</th>
                    <th>Дата</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Resources)
                {
                    <tr>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="fw-bold text-decoration-none">
                                @item.Title
                            </a>
                        </td>
                        <td>@foreach (var c in item.Categories.OrderBy(c => c.Name)) { <span class="badge bg-primary text-primary-emphasis">@c.Name</span> }</td>
                        <td>@foreach (var g in item.GradeLevels.OrderBy(g => g.Number)) { <span class="badge bg-secondary text-secondary-emphasis">@g.Name</span> }</td>
                        <td class="small">@(item.Owner?.FullName ?? "Изтрит потребител")</td>
                        <td class="small text-body-secondary">@item.CreatedOn.ToString("dd.MM.yyyy")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Детайли</a>
                            @if (User.Identity?.IsAuthenticated == true && item.OwnerId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value 
                            || User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Редактирай</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Изтрий</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}