@model IEnumerable<SchoolLibrary.Data.Models.Resource>

@{
    ViewData["Title"] = "Ресурси";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Учебни ресурси</h1>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-action="Create" class="btn btn-primary">+ Нов ресурс</a>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center py-5">
        <p class="mb-0">Все още няма добавени ресурси.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Заглавие</th>
                    <th>Категория</th>
                    <th>Клас</th>
                    <th>Публикувал</th>
                    <th>Дата</th>
                    <th class="text-end">Операции</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="fw-bold text-decoration-none">
                                @item.Title
                            </a>
                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <div class="small text-muted">
                                    @(item.Description.Length > 80 ? item.Description.Substring(0, 80) + "..." : item.Description)
                                </div>
                            }
                        </td>
                        <td>
                            <span class="badge bg-primary text-primary-emphasis">@item.Category.Name</span>
                        </td>
                        <td>
                            <span class="badge bg-info text-info-emphasis">@item.GradeLevel.Name</span>
                        </td>
                        <td class="small text-muted">
                            @item.Owner.Email
                        </td>
                        <td class="small text-muted">
                            @item.CreatedOn.ToString("dd.MM.yyyy")
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Детайли</a>
                            @if (User.Identity?.IsAuthenticated == true && item.OwnerId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value)
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Редактирай</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Изтрий</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}