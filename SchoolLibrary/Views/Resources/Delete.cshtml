@model SchoolLibrary.Data.Models.Resource

@{
    ViewData["Title"] = "Изтриване на ресурс";
}

<h1 class="text-danger">Изтриване на ресурс</h1>

<div class="alert alert-warning">
    <strong>Сигурни ли сте, че искате да изтриете този ресурс?</strong>
    <br />
    Действието не може да бъде отменено.
</div>

<dl class="row">
    <dt class="col-sm-2">Заглавие</dt>
    <dd class="col-sm-10">@Model.Title</dd>

    <dt class="col-sm-2">Категория</dt>
    <dd class="col-sm-10">@Model.Category.Name</dd>

    <dt class="col-sm-2">Клас</dt>
    <dd class="col-sm-10">@Model.GradeLevel.Name</dd>

    <dt class="col-sm-2">URL</dt>
    <dd class="col-sm-10"><a href="@Model.Url" target="_blank">@Model.Url</a></dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Да, изтрий</button>
    <a asp-action="Index" class="btn btn-secondary">Отказ</a>
</form>