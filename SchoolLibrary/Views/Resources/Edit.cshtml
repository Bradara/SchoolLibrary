@model SchoolLibrary.ViewModels.ResourceFormViewModel

@{
    ViewData["Title"] = "Редактирай ресурс";
}

<h1>Редактирай ресурс</h1>

<h4>Редактиране на учебен ресурс</h4>
<hr />
<div class="row">
    <div class="col-lg-8">
        <form asp-action="Edit">
            <input type="hidden" asp-for="Id" />
            <partial name="_ResourceForm" model="Model" />

            <div class="form-group mt-4">
                <input type="submit" value="Запази" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Отказ</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
